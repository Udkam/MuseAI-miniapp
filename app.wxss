/* Global tokens */
page {
  background-color: #F8F3EA;
  color: #241712;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* Buttons */
.btn-primary {
  display: block;
  width: 100%;
  min-height: 88rpx;
  padding: 22rpx 24rpx;
  background: #3F2A1D;
  color: #FFF9F1;
  border-radius: 6rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  letter-spacing: 2rpx;
  line-height: 44rpx;
  box-sizing: border-box;
}

.btn-primary::after { border: none; }

.btn-secondary {
  display: block;
  width: 100%;
  min-height: 88rpx;
  padding: 20rpx 24rpx;
  background: transparent;
  color: #3F2A1D;
  border: 2rpx solid #A85732;
  border-radius: 6rpx;
  font-size: 30rpx;
  text-align: center;
  letter-spacing: 2rpx;
  line-height: 44rpx;
  box-sizing: border-box;
}

.btn-secondary::after { border: none; }

/* Cards */
.card {
  background: #F3EADD;
  border: 2rpx solid #E6D8C6;
  border-radius: 4rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

/* Divider */
.divider {
  height: 2rpx;
  background: #D8C8B4;
  margin: 32rpx 0;
}

/* Page layout */
.page-wrap {
  min-height: 100vh;
  padding: 40rpx 32rpx calc(48rpx + constant(safe-area-inset-bottom));
  padding: 40rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* Text helpers */
.text-clay   { color: #A85732; }
.text-brown  { color: #3F2A1D; }
.text-muted  { color: #7C6654; }
.text-gold   { color: #C99A4A; }
.text-center { text-align: center; }
.text-sm     { font-size: 24rpx; }
.text-lg     { font-size: 36rpx; }
.text-xl     { font-size: 44rpx; }
.text-bold   { font-weight: 600; }
