<view class="page-wrap home">

  <!-- Hero -->
  <view class="hero">
    <view class="hero-emblem">𓂀</view>
    <text class="hero-title">半坡遗址</text>
    <text class="hero-sub">AI 智慧导览</text>
    <text class="hero-tagline">与六千年前的半坡先民相遇</text>
  </view>

  <!-- Actions -->
  <view class="actions">
    <button class="btn-primary" bindtap="goOnboarding">开始个性化导览</button>
    <view style="margin-top:20rpx;">
      <button class="btn-secondary" bindtap="goQuickStart">直接开始，默认体验</button>
    </view>
    <view wx:if="{{hasTourSession}}" class="resume-card" bindtap="resumeTour">
      <view class="resume-copy">
        <text class="resume-label">继续上次导览</text>
        <text wx:if="{{resumeHallName}}" class="resume-title">{{resumeHallName}}</text>
        <text class="resume-meta">已完成 {{aiConversationCount}} 次 AI 对话</text>
      </view>
      <text class="resume-arrow">›</text>
    </view>
  </view>

  <!-- Footer note -->
  <view class="footer-note">
    <text class="text-muted text-sm text-center">陕西省西安市半坡博物馆 · 国家一级博物馆</text>
  </view>

</view>
