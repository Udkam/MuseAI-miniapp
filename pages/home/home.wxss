.home {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #F8F3EA;
  padding: 0 48rpx;
}

.hero {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0 80rpx;
}

.hero-emblem {
  font-size: 88rpx;
  line-height: 1;
  margin-bottom: 24rpx;
  color: #C7A27C;
}

.hero-title {
  font-size: 60rpx;
  font-weight: 700;
  color: #241712;
  letter-spacing: 8rpx;
}

.hero-sub {
  font-size: 32rpx;
  color: #A85732;
  margin-top: 8rpx;
  letter-spacing: 6rpx;
}

.hero-tagline {
  font-size: 26rpx;
  color: #7C6654;
  margin-top: 24rpx;
  letter-spacing: 2rpx;
}

.actions {
  padding: 0 0 48rpx;
}

.entry-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.entry-primary,
.entry-secondary {
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 0 28rpx 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  line-height: 1;
  transition: transform 120ms ease, background-color 120ms ease, color 120ms ease;
}

.entry-primary::after,
.entry-secondary::after {
  border: 0;
}

.entry-primary {
  height: 104rpx;
  color: #FFF9F1;
  background: #5A3E2B;
  border: 0;
  border-radius: 6rpx;
  box-shadow: inset 7rpx 0 0 #A85732;
}

.entry-secondary {
  height: 88rpx;
  color: #5A3E2B;
  background: transparent;
  border: 0;
  border-bottom: 2rpx solid #D8C8B4;
  border-radius: 0;
}

.entry-label {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.entry-secondary .entry-label {
  font-size: 28rpx;
  font-weight: 650;
}

.entry-arrow {
  font-size: 42rpx;
  font-weight: 300;
  line-height: 1;
}

.entry-primary-pressed {
  transform: translateY(3rpx);
  background: #493121;
}

.entry-secondary-pressed {
  transform: translateX(4rpx);
  color: #A85732;
  background: rgba(168, 87, 50, 0.05);
}

.resume-card {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  background: #FFF9F1;
  border: 2rpx solid #E6D8C6;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(61, 43, 26, 0.06);
}

.resume-copy {
  min-width: 0;
  flex: 1;
}

.resume-label {
  display: block;
  color: #A85732;
  font-size: 22rpx;
  line-height: 1.35;
}

.resume-title {
  display: block;
  color: #241712;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
  margin-top: 4rpx;
}

.resume-meta {
  display: block;
  color: #7C6654;
  font-size: 22rpx;
  line-height: 1.35;
  margin-top: 4rpx;
}

.resume-arrow {
  color: #A85732;
  font-size: 46rpx;
  line-height: 1;
  flex-shrink: 0;
}

.footer-note {
  padding-bottom: 60rpx;
  display: flex;
  justify-content: center;
}
