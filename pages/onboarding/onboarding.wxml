<view class="page-wrap onboarding">

  <!-- Progress -->
  <view class="progress-row">
    <text class="step-label">第 {{step + 1}} 题 / 共 3 题</text>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{(step + 1) / 3 * 100}}%"></view>
    </view>
  </view>

  <!-- Question -->
  <view class="question-block">
    <text class="question-text">{{questions[step].text}}</text>
    <text class="question-hint">{{questions[step].hint}}</text>
  </view>

  <!-- Options -->
  <view class="options-list">
    <view
      wx:for="{{questions[step].options}}"
      wx:key="key"
      class="option-item {{answers[step] === item.key ? 'selected' : ''}}"
      bindtap="selectOption"
      data-key="{{item.key}}"
    >
      <view class="option-badge">
        <text wx:if="{{answers[step] === item.key}}" class="option-check">✓</text>
        <text wx:else>{{item.key}}</text>
      </view>
      <view class="option-body">
        <text class="option-title">{{item.label}}</text>
        <text class="option-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <!-- Next button -->
  <view class="bottom-action">
    <button
      class="btn-primary {{(canNext && !loading) ? '' : 'btn-disabled'}}"
      loading="{{loading}}"
      bindtap="goNext"
    >{{loading ? '创建导览会话…' : (step < 2 ? '下一题 →' : '揭晓我的身份 →')}}</button>
  </view>

</view>
