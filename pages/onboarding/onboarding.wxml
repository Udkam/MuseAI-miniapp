<view class="page-wrap onboarding {{loading ? 'is-busy' : ''}}">

  <!-- ═══ STEP 1: Intent cards ═══════════════════════════════════════════════ -->
  <view hidden="{{step !== 1}}">

    <view class="ob-header">
      <text class="ob-title">今天来半坡，</text>
      <text class="ob-title">你最想——</text>
    </view>

    <!-- 2×2 intent card grid -->
    <view class="card-grid">
      <view
        wx:for="{{intentCards}}"
        wx:key="id"
        class="intent-card {{selectedCardId === item.id ? 'selected' : ''}}"
        bindtap="selectCard"
        data-id="{{item.id}}"
      >
        <view hidden="{{selectedCardId !== item.id}}" class="card-check">✓</view>
        <text class="card-icon">{{item.icon}}</text>
        <text class="card-title">{{item.title}}</text>
        <text class="card-desc">{{item.desc}}</text>
      </view>
    </view>

    <!-- Natural language input (optional) -->
    <view class="intent-input-wrap">
      <input
        class="intent-input"
        placeholder="或者，用自己的话说……（选填）"
        placeholder-class="intent-placeholder"
        maxlength="50"
        bindinput="onIntentInput"
        value="{{intentText}}"
      />
    </view>

    <!-- Inline persona preview after card selection -->
    <view wx:if="{{selectedCardPersonaName}}" class="persona-preview">
      <text class="persona-preview-text">✨ 你的 AI 导览员将以「{{selectedCardPersonaName}}」身份陪你</text>
    </view>

    <view class="bottom-action">
      <button
        class="btn-primary"
        loading="{{false}}"
        disabled="{{loading}}"
        bindtap="goToStep2"
      >{{selectedCardId ? '好，继续 →' : '直接开始导览 →'}}</button>
    </view>

  </view>

  <!-- ═══ STEP 2: Time budget ═════════════════════════════════════════════════ -->
  <view hidden="{{step !== 2}}">

    <view class="ob-header">
      <text class="ob-title">今天大概有</text>
      <text class="ob-title">多少时间？</text>
      <text class="ob-hint">这会影响 AI 给你的内容详略</text>
    </view>

    <view class="time-list">
      <view
        wx:for="{{timeOptions}}"
        wx:key="id"
        class="time-item {{selectedTimeId === item.id ? 'selected' : ''}}"
        bindtap="selectTime"
        data-id="{{item.id}}"
      >
        <text class="time-icon">{{item.icon}}</text>
        <view class="time-body">
          <text class="time-title">{{item.title}}</text>
          <text class="time-desc">{{item.desc}}</text>
        </view>
        <view hidden="{{selectedTimeId !== item.id}}" class="time-check">✓</view>
      </view>
    </view>

    <view class="time-bottom">
      <button
        class="btn-primary"
        loading="{{false}}"
        disabled="{{loading}}"
        bindtap="confirmTime"
      >进入导览 →</button>
      <text class="skip-link {{loading ? 'disabled' : ''}}" bindtap="skipTime">跳过，自由参观 →</text>
    </view>

  </view>

  <view wx:if="{{loading}}" class="creating-mask" catchtap="noop" catchtouchmove="noop">
    <view class="creating-panel">
      <view class="creating-spinner"></view>
      <text class="creating-title">正在创建导览…</text>
      <text class="creating-subtitle">MuseAI 正在整理你的路线</text>
    </view>
  </view>

</view>
