.onboarding {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.progress-row {
  margin-bottom: 48rpx;
}

.step-label {
  font-size: 24rpx;
  color: #8B6B55;
  display: block;
  margin-bottom: 12rpx;
}

.progress-track {
  height: 8rpx;
  background: #DDD0C0;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #C4845A;
  border-radius: 4rpx;
  transition: width 0.3s;
}

.question-block {
  margin-bottom: 48rpx;
}

.question-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #3D2B1A;
  line-height: 1.4;
}

.options-list {
  flex: 1;
}

.option-item {
  display: flex;
  align-items: flex-start;
  background: #F5F0E8;
  border: 3rpx solid transparent;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  transition: border-color 0.2s, background 0.2s;
}

.option-item.selected {
  border-color: #C4845A;
  background: #FFF8F2;
}

.option-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #DDD0C0;
  color: #3D2B1A;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
  margin-top: 4rpx;
}

.option-item.selected .option-badge {
  background: #C4845A;
  color: #FAF7F2;
}

.option-body {
  flex: 1;
}

.option-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C1810;
  display: block;
  margin-bottom: 8rpx;
}

.option-desc {
  font-size: 26rpx;
  color: #8B6B55;
  line-height: 1.5;
}

.bottom-action {
  padding: 40rpx 0 60rpx;
}

.btn-disabled {
  opacity: 0.45;
}
