.onboarding {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

/* ── Progress ──────────────────────────────────────────────────────────────── */

.progress-row {
  margin-bottom: 48rpx;
}

.step-label {
  font-size: 24rpx;
  color: #8B6B55;
  display: block;
  margin-bottom: 16rpx;
}

.progress-track {
  height: 10rpx;
  background: #DDD0C0;
  border-radius: 5rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #C4845A, #E8A878);
  border-radius: 5rpx;
  transition: width 0.35s ease-out;
}

/* ── Question ──────────────────────────────────────────────────────────────── */

.question-block {
  margin-bottom: 40rpx;
}

.question-text {
  font-size: 38rpx;
  font-weight: 700;
  color: #3D2B1A;
  line-height: 1.45;
  display: block;
  margin-bottom: 12rpx;
}

.question-hint {
  font-size: 24rpx;
  color: #B08060;
  display: block;
  line-height: 1.5;
}

/* ── Options ───────────────────────────────────────────────────────────────── */

.options-list {
  flex: 1;
}

.option-item {
  display: flex;
  align-items: flex-start;
  background: #F5F0E8;
  border: 3rpx solid transparent;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
}

.option-item.selected {
  border-color: #C4845A;
  background: #FFF8F2;
  box-shadow: 0 4rpx 20rpx rgba(196, 132, 90, 0.18);
}

.option-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #DDD0C0;
  color: #3D2B1A;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
  margin-top: 4rpx;
  transition: background 0.2s, color 0.2s;
}

.option-item.selected .option-badge {
  background: #C4845A;
  color: #FAF7F2;
}

.option-check {
  font-size: 30rpx;
}

.option-body {
  flex: 1;
}

.option-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C1810;
  display: block;
  margin-bottom: 8rpx;
}

.option-item.selected .option-title {
  color: #C4845A;
}

.option-desc {
  font-size: 26rpx;
  color: #8B6B55;
  line-height: 1.55;
}

/* ── Bottom action ─────────────────────────────────────────────────────────── */

.bottom-action {
  padding: 40rpx 0 60rpx;
}

.btn-disabled {
  opacity: 0.45;
}
