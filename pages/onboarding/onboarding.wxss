.onboarding {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FAF7F2;
  position: relative;
  overflow-x: hidden;
}

.onboarding.is-busy {
  height: 100vh;
  overflow: hidden;
}

.progress-row {
  display: flex;
  gap: 12rpx;
  padding: 8rpx 0 28rpx;
}

.progress-dot {
  width: 44rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #E8DCCB;
}

.progress-dot.active {
  width: 88rpx;
  background: #C4845A;
}

.step-panel {
  flex: 1;
  min-height: 0;
}

.ob-header {
  padding-bottom: 32rpx;
}

.ob-kicker {
  display: block;
  font-size: 23rpx;
  color: #B08060;
  margin-bottom: 12rpx;
}

.ob-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #2C1810;
  display: block;
  line-height: 1.35;
}

.ob-hint {
  font-size: 25rpx;
  color: #8B6B55;
  display: block;
  margin-top: 14rpx;
  line-height: 1.55;
}

.option-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.profile-card {
  background: #F5F0E8;
  border: 3rpx solid transparent;
  border-radius: 18rpx;
  padding: 28rpx 22rpx 24rpx;
  min-height: 210rpx;
  box-sizing: border-box;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.profile-card.selected,
.choice-item.selected {
  border-color: #C4845A;
  background: #FFF8F2;
  box-shadow: 0 4rpx 18rpx rgba(196, 132, 90, 0.16);
}

.card-check,
.choice-check {
  width: 42rpx;
  height: 42rpx;
  background: #C4845A;
  color: #FAF7F2;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.card-check {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
}

.card-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 16rpx;
}

.card-title,
.choice-title {
  font-size: 29rpx;
  font-weight: 700;
  color: #2C1810;
  line-height: 1.35;
  display: block;
}

.profile-card.selected .card-title,
.choice-item.selected .choice-title {
  color: #C4845A;
}

.card-desc,
.choice-desc {
  font-size: 24rpx;
  color: #8B6B55;
  line-height: 1.5;
  display: block;
  margin-top: 10rpx;
}

.intent-input-wrap {
  background: #F5F0E8;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 18rpx;
}

.intent-input {
  width: 100%;
  font-size: 27rpx;
  color: #2C1810;
  line-height: 1.5;
}

.intent-placeholder {
  color: #BDA58A;
  font-size: 25rpx;
}

.persona-preview {
  background: #FFF8F2;
  border-left: 5rpx solid #C4845A;
  border-radius: 0 12rpx 12rpx 0;
  padding: 16rpx 20rpx;
}

.persona-preview-text {
  font-size: 25rpx;
  color: #8B6B55;
  line-height: 1.5;
}

.choice-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.choice-item {
  display: flex;
  align-items: center;
  background: #F5F0E8;
  border: 3rpx solid transparent;
  border-radius: 18rpx;
  padding: 22rpx 22rpx;
  min-height: 96rpx;
  box-sizing: border-box;
}

.choice-icon {
  font-size: 42rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.choice-body {
  flex: 1;
  min-width: 0;
}

.bottom-action {
  padding: 24rpx 0 calc(58rpx + constant(safe-area-inset-bottom));
  padding: 24rpx 0 calc(58rpx + env(safe-area-inset-bottom));
}

.secondary-row {
  min-height: 46rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.text-action {
  font-size: 26rpx;
  color: #9B6F4D;
}

.text-action.muted {
  margin-left: auto;
  color: #B08060;
}

.text-action.disabled {
  opacity: 0.45;
}

.btn-primary[disabled] {
  background: #3D2B1A;
  color: #F5F0E8;
  opacity: 0.88;
}

.creating-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 99;
  background: rgba(250, 247, 242, 0.96);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.creating-panel {
  width: 360rpx;
  min-height: 240rpx;
  background: #3D2B1A;
  color: #F5F0E8;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 18rpx 50rpx rgba(61, 43, 26, 0.22);
}

.creating-spinner {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 5rpx solid rgba(245, 240, 232, 0.28);
  border-top-color: #F5F0E8;
  animation: creating-spin 0.8s linear infinite;
  margin-bottom: 22rpx;
}

.creating-title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
}

.creating-subtitle {
  font-size: 23rpx;
  color: rgba(245, 240, 232, 0.72);
  line-height: 1.4;
  margin-top: 8rpx;
}

@keyframes creating-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
