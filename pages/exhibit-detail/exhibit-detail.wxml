<view class="page-wrap detail">

  <view wx:if="{{loading}}" class="state-wrap">
    <text class="text-muted text-sm">加载展品资料中…</text>
  </view>

  <view wx:elif="{{loadError}}" class="state-wrap">
    <image class="empty-icon-img" src="/assets/icons/exhibit-empty-search.png" mode="aspectFit"></image>
    <text class="empty-text text-muted">{{errorMessage}}</text>
    <button class="btn-secondary" style="margin-top:28rpx;" bindtap="goNext">返回</button>
  </view>

  <block wx:else>

  <view class="exhibit-img-wrap">
    <image
      class="exhibit-img {{usingDefaultImage ? 'is-default' : ''}}"
      src="{{exhibitImageSrc}}"
      mode="{{usingDefaultImage ? 'aspectFit' : 'aspectFill'}}"
      binderror="onExhibitImageError"
      aria-label="{{usingDefaultImage ? '展品默认图片' : exhibit.name}}"
    ></image>
    <view class="image-caption">
      <text>{{exhibit.category || '展品'}}</text>
      <text wx:if="{{usingDefaultImage}}">暂无馆方图片</text>
    </view>
  </view>

  <!-- Basic info -->
  <view class="exhibit-info card">
    <text class="exhibit-name">{{exhibit.name}}</text>
    <view class="exhibit-tags">
      <text wx:if="{{exhibit.category}}" class="tag">{{exhibit.category}}</text>
      <text wx:if="{{exhibit.era}}"      class="tag">{{exhibit.era}}</text>
      <text wx:if="{{exhibit.hallDisplay}}" class="tag tag-hall">{{exhibit.hallDisplay}}</text>
    </view>
  </view>

  <!-- Description -->
  <view class="card">
    <view class="detail-section-heading">
      <text class="detail-section-index">01</text>
      <text class="section-title">展品简介</text>
    </view>
    <text class="desc-text" selectable="{{true}}" user-select="{{true}}">{{exhibit.description}}</text>
  </view>

  <!-- Actions -->
  <view class="action-row">
    <button class="btn-primary" bindtap="goDeeper">围绕这件展品提问</button>
    <button class="btn-secondary" style="margin-top:20rpx;" bindtap="goNext">返回</button>
  </view>

  </block>

</view>
