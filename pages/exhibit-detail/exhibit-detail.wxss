.detail {
  min-height: 100vh;
}

.exhibit-img-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 32rpx;
}

.exhibit-img-placeholder {
  width: 280rpx;
  height: 280rpx;
  background: #EDE3D6;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.exhibit-img-icon {
  font-size: 96rpx;
}

.exhibit-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #3D2B1A;
  display: block;
  margin-bottom: 20rpx;
}

.exhibit-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 24rpx;
  color: #8B6B55;
  background: #EDE3D6;
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
}

.tag-hall {
  background: #C4845A22;
  color: #C4845A;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 16rpx;
}

.desc-text {
  font-size: 28rpx;
  color: #5A3E2B;
  line-height: 1.8;
}

.action-row {
  margin-top: 16rpx;
}
