.detail {
  min-height: 100vh;
}

.exhibit-img-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 32rpx;
}

.exhibit-img-placeholder {
  width: 280rpx;
  height: 280rpx;
  background: linear-gradient(135deg, #FFF9F1 0%, #E7D8C5 100%);
  border: 2rpx solid #E6D8C6;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.exhibit-img-icon {
  font-size: 112rpx;
  line-height: 1;
}

.exhibit-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #3F2A1D;
  display: block;
  margin-bottom: 20rpx;
}

.exhibit-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 24rpx;
  color: #7C6654;
  background: #E7D8C5;
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
}

.tag-hall {
  background: #A8573222;
  color: #A85732;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 16rpx;
}

.desc-text {
  font-size: 28rpx;
  color: #5A3E2B;
  line-height: 1.8;
}

.action-row {
  margin-top: 16rpx;
}
