<view class="page-wrap hall">

  <view class="hall-header">
    <view class="hall-title-row">
      <view class="hall-title-copy">
        <text class="hall-title">选择你的探索区域</text>
        <text class="hall-sub text-muted text-sm">按固定展厅顺序浏览，也可以从现场所在展厅开始</text>
      </view>
      <view class="route-entry" bindtap="goRoute">
        <text class="route-entry-icon">🧭</text>
        <text class="route-entry-text">路线</text>
      </view>
    </view>
  </view>

  <view class="hall-list">
    <view
      wx:for="{{halls}}"
      wx:key="id"
      class="hall-card{{item.isVisited ? ' visited' : ''}}"
      bindtap="selectHall"
      data-hall="{{item}}"
    >
      <view class="hall-order">{{item.order}}</view>
      <view class="hall-icon-wrap">
        <image wx:if="{{item.iconSrc}}" class="hall-icon-img" src="{{item.iconSrc}}" mode="aspectFit"></image>
        <text wx:else class="hall-icon">{{item.icon}}</text>
      </view>
      <view class="hall-info">
        <text class="hall-name">{{item.name}}</text>
        <text class="hall-desc text-muted">{{item.desc}}</text>
      </view>
      <text wx:if="{{item.isVisited}}" class="hall-visited-badge">已浏览</text>
      <text class="hall-arrow text-clay">›</text>
    </view>
  </view>

</view>
