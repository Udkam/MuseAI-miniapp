.hall-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F8F3EA;
  overflow: hidden;
}

.hall-topbar {
  background: #3D2B1A;
  border-bottom: 1rpx solid rgba(255, 249, 241, 0.14);
  flex-shrink: 0;
  box-sizing: border-box;
  min-height: 132rpx;
  padding-top: 44rpx;
}

.hall-topbar-row {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  padding: 0 176rpx 0 88rpx;
  box-sizing: border-box;
  position: relative;
}

.hall-topbar-back {
  width: 88rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFF9F1;
  flex-shrink: 0;
  position: absolute;
  left: 8rpx;
  top: 0;
}

.hall-topbar-chevron {
  width: 22rpx;
  height: 22rpx;
  border-left: 4rpx solid #FFF9F1;
  border-bottom: 4rpx solid #FFF9F1;
  transform: rotate(45deg);
}

.hall-topbar-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFF9F1;
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

.hall-topbar-right-spacer {
  width: 176rpx;
  height: 1rpx;
  position: absolute;
  right: 0;
  top: 0;
}

.hall-scroll {
  flex: 1;
  min-height: 0;
  background: #F8F3EA;
}

.hall {
  min-height: auto;
}

.hall-header {
  padding: 40rpx 0 32rpx;
  border-bottom: 2rpx solid #D8C8B4;
  margin-bottom: 24rpx;
}

.hall-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.hall-title-copy {
  flex: 1;
  min-width: 0;
}

.hall-header-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.hall-title {
  font-family: 'Songti SC', 'STSong', serif;
  font-size: 46rpx;
  font-weight: 700;
  color: #3F2A1D;
  display: block;
}

.route-entry {
  display: flex;
  align-items: center;
  gap: 8rpx;
  border: 2rpx solid #D8B08C;
  min-width: 88rpx;
  min-height: 88rpx;
  border-radius: 4rpx;
  padding: 8rpx 12rpx;
  color: #8B5E3C;
  background: #FFF9F1;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
}

.route-entry-img {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}

.route-entry-text {
  font-size: 24rpx;
  font-weight: 650;
}

/* ── Route summary ─────────────────────────────────────────────────────────── */

.route-summary-card {
  background: #FFFAF5;
  border: 2rpx solid #EDD8B8;
  border-radius: 18rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 30rpx;
}

.route-summary-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 14rpx;
}

.route-summary-label {
  font-size: 24rpx;
  color: #A85732;
  font-weight: 600;
}

.route-summary-source {
  font-size: 20rpx;
  color: #7C6654;
  background: #F3EADD;
  border-radius: 100rpx;
  padding: 5rpx 16rpx;
  flex-shrink: 0;
}

.route-summary-line {
  display: block;
  font-size: 29rpx;
  font-weight: 650;
  color: #3F2A1D;
  line-height: 1.55;
  margin-bottom: 10rpx;
}

.route-summary-hint {
  display: block;
  font-size: 23rpx;
  color: #7C6654;
  line-height: 1.55;
}

.route-summary-notice {
  display: block;
  font-size: 22rpx;
  color: #B08060;
  line-height: 1.5;
  margin-top: 8rpx;
}

.hall-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.hall-card {
  display: flex;
  align-items: center;
  background: #F3EADD;
  border: 2rpx solid #E6D8C6;
  border-radius: 4rpx;
  padding: 22rpx 24rpx;
  gap: 18rpx;
  width: 100%;
  height: 154rpx;
  box-sizing: border-box;
}

.hall-icon-wrap {
  width: 76rpx;
  height: 76rpx;
  background: rgba(255, 249, 241, 0.5);
  border: 0;
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hall-icon {
  font-size: 42rpx;
  line-height: 1;
}

.hall-icon-img {
  width: 56rpx;
  height: 56rpx;
  display: block;
}

.hall-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 12rpx;
}

.hall-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #241712;
  display: block;
  min-width: 0;
  line-height: 40rpx;
}

.hall-desc {
  font-size: 24rpx;
  line-height: 34rpx;
  display: block;
  white-space: nowrap;
}

.hall-arrow {
  font-size: 40rpx;
  line-height: 1;
  text-align: right;
}

.hall-trailing {
  width: 70rpx;
  min-height: 68rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

.hall-card.visited .hall-trailing {
  justify-content: space-between;
}

.hall-card + .hall-card {
  border-top: 0;
}

/* ── Visited state ──────────────────────────────────────────────────────────── */

.hall-card.visited {
  background: #E7D8C5;
  border-left: 6rpx solid #8B5E3C;
}

.hall-visited-badge {
  font-size: 20rpx;
  font-weight: 650;
  color: #8B5E3C;
  background: transparent;
  border: 0;
  border-radius: 0;
  padding: 0;
  flex-shrink: 0;
  line-height: 1.35;
}

/* ── Recommended badge ──────────────────────────────────────────────────────── */
