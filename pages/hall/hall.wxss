.hall {
  min-height: 100vh;
}

.hall-header {
  padding: 40rpx 0 48rpx;
}

.hall-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #3D2B1A;
  display: block;
  margin-bottom: 12rpx;
}

.hall-sub {
  display: block;
}

.hall-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.hall-card {
  display: flex;
  align-items: center;
  background: #F5F0E8;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  gap: 24rpx;
}

.hall-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  background: #EDE3D6;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hall-icon {
  font-size: 48rpx;
}

.hall-info {
  flex: 1;
  overflow: hidden;
}

.hall-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C1810;
  display: block;
}

.hall-desc {
  font-size: 24rpx;
  line-height: 1.5;
  display: block;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.hall-arrow {
  font-size: 48rpx;
  flex-shrink: 0;
}

/* ── Recommended badge ──────────────────────────────────────────────────────── */

.hall-card.recommended {
  border: 3rpx solid #C4845A;
}

.hall-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.hall-recommend-badge {
  background: #C4845A;
  color: #FAF7F2;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
  flex-shrink: 0;
}
