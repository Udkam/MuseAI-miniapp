.hall {
  min-height: 100vh;
}

.hall-header {
  padding: 40rpx 0 48rpx;
}

.hall-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.hall-title-copy {
  flex: 1;
  min-width: 0;
}

.hall-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #3F2A1D;
  display: block;
  margin-bottom: 12rpx;
}

.hall-sub {
  display: block;
}

.route-entry {
  display: flex;
  align-items: center;
  gap: 8rpx;
  border: 2rpx solid #D8B08C;
  border-radius: 100rpx;
  padding: 12rpx 20rpx;
  color: #8B5E3C;
  background: #FFF9F1;
  flex-shrink: 0;
}

.route-entry-icon {
  font-size: 30rpx;
  line-height: 1;
  flex-shrink: 0;
}

.route-entry-text {
  font-size: 24rpx;
  font-weight: 650;
}

/* ── Route summary ─────────────────────────────────────────────────────────── */

.route-summary-card {
  background: #FFFAF5;
  border: 2rpx solid #EDD8B8;
  border-radius: 18rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 30rpx;
}

.route-summary-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 14rpx;
}

.route-summary-label {
  font-size: 24rpx;
  color: #A85732;
  font-weight: 600;
}

.route-summary-source {
  font-size: 20rpx;
  color: #7C6654;
  background: #F3EADD;
  border-radius: 100rpx;
  padding: 5rpx 16rpx;
  flex-shrink: 0;
}

.route-summary-line {
  display: block;
  font-size: 29rpx;
  font-weight: 650;
  color: #3F2A1D;
  line-height: 1.55;
  margin-bottom: 10rpx;
}

.route-summary-hint {
  display: block;
  font-size: 23rpx;
  color: #7C6654;
  line-height: 1.55;
}

.route-summary-notice {
  display: block;
  font-size: 22rpx;
  color: #B08060;
  line-height: 1.5;
  margin-top: 8rpx;
}

.hall-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.hall-card {
  display: flex;
  align-items: center;
  background: #F3EADD;
  border: 2rpx solid #E6D8C6;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  gap: 20rpx;
}

.hall-order {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #D8B08C;
  color: #F8F3EA;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-align: center;
  flex-shrink: 0;
}

.hall-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #FFF9F1 0%, #E7D8C5 100%);
  border: 2rpx solid #E6D8C6;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hall-icon {
  font-size: 48rpx;
  line-height: 1;
}

.hall-icon-img {
  width: 54rpx;
  height: 54rpx;
  display: block;
}

.hall-info {
  flex: 1;
  overflow: hidden;
}

.hall-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #241712;
  display: block;
}

.hall-desc {
  font-size: 24rpx;
  line-height: 1.5;
  display: block;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.hall-arrow {
  font-size: 48rpx;
  flex-shrink: 0;
}

/* ── Visited state ──────────────────────────────────────────────────────────── */

.hall-card.visited {
  background: #E7D8C5;
}

.hall-visited-badge {
  font-size: 20rpx;
  font-weight: 650;
  color: #8B5E3C;
  background: #FFF9F1;
  border: 2rpx solid #D8B08C;
  border-radius: 100rpx;
  padding: 4rpx 14rpx;
  flex-shrink: 0;
}

/* ── Recommended badge ──────────────────────────────────────────────────────── */
