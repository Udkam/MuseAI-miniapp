<view wx:if="{{isLoading}}" class="report-loading">
  <text class="report-loading-icon">📋</text>
  <view class="report-loading-dots">
    <view class="rdot"></view>
    <view class="rdot"></view>
    <view class="rdot"></view>
  </view>
  <text class="report-loading-text">正在整理你的游览记录…</text>
</view>

<scroll-view wx:if="{{isReady}}" scroll-y class="report-scroll">
<view class="page-wrap report">

  <view class="report-header">
    <text class="report-badge-icon">📜</text>
    <text class="report-title">{{reportTitle}}</text>
    <text class="report-persona text-clay">身份：{{persona}}</text>
  </view>

  <view class="stats-grid">
    <view class="stat-item">
      <text class="stat-num">{{stats.halls}}</text>
      <text class="stat-label text-muted">展厅</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{stats.exhibits}}</text>
      <text class="stat-label text-muted">展项</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{stats.messages}}</text>
      <text class="stat-label text-muted">问题</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{stats.duration}}</text>
      <text class="stat-label text-muted">时长</text>
    </view>
  </view>

  <view class="card summary-card">
    <text class="section-label text-clay text-bold">本次游览总结</text>
    <text class="summary-text">{{journeySummary}}</text>
  </view>

  <view wx:if="{{visitedHallCards.length > 0}}" class="card">
    <text class="section-label text-clay text-bold">到访展厅</text>
    <view class="hall-card-list">
      <view wx:for="{{visitedHallCards}}" wx:key="name" class="hall-summary-row">
        <text class="hall-summary-name">{{item.name}}</text>
        <text class="hall-summary-note">{{item.note}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <text class="section-label text-clay text-bold">你的提问线索</text>
    <text class="summary-text">{{questionSummary}}</text>
    <view wx:if="{{questionSamples.length > 0}}" class="question-list">
      <view wx:for="{{questionSamples}}" wx:key="*this" class="question-row">
        <text class="question-mark">问</text>
        <text class="question-text">{{item}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{takeaways.length > 0}}" class="card">
    <text class="section-label text-clay text-bold">可带走的结论</text>
    <view class="highlight-list">
      <view wx:for="{{takeaways}}" wx:key="*this" class="highlight-row">
        <text class="highlight-dot text-gold">◆</text>
        <text class="highlight-text">{{item}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{nextSuggestions.length > 0}}" class="card">
    <text class="section-label text-clay text-bold">下一步建议</text>
    <view class="highlight-list">
      <view wx:for="{{nextSuggestions}}" wx:key="*this" class="highlight-row">
        <text class="highlight-dot text-gold">◆</text>
        <text class="highlight-text">{{item}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{reviewChecklist.length > 0}}" class="card">
    <text class="section-label text-clay text-bold">复盘清单</text>
    <view class="review-list">
      <view wx:for="{{reviewChecklist}}" wx:key="label" class="review-row">
        <text class="review-label">{{item.label}}</text>
        <text class="review-text">{{item.text}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{highlights.length > 0}}" class="card compact-card">
    <text class="section-label text-clay text-bold">记录摘要</text>
    <view class="highlight-list">
      <view wx:for="{{highlights}}" wx:key="*this" class="highlight-row">
        <text class="highlight-dot text-gold">◆</text>
        <text class="highlight-text">{{item}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{dataNotice || loadError}}" class="error-notice">
    <text class="error-notice-text">{{dataNotice}}</text>
  </view>

  <view class="report-actions">
    <button class="btn-primary" bindtap="shareReport">分享报告</button>
    <button class="btn-secondary" style="margin-top:20rpx;" bindtap="goHome">返回首页</button>
  </view>

</view>
</scroll-view>
