<!-- ── Loading state ─────────────────────────────────────────────────────── -->
<view wx:if="{{isLoading}}" class="report-loading">
  <text class="report-loading-icon">📊</text>
  <view class="report-loading-dots">
    <view class="rdot"></view>
    <view class="rdot"></view>
    <view class="rdot"></view>
  </view>
  <text class="report-loading-text">正在生成你的专属报告…</text>
</view>

<!-- ── Report content ─────────────────────────────────────────────────────── -->
<scroll-view wx:if="{{isReady}}" scroll-y class="report-scroll">
<view class="page-wrap report">

  <!-- Header -->
  <view class="report-header">
    <text class="report-badge-icon">📜</text>
    <text class="report-title">{{reportTitle}}</text>
    <text class="report-persona text-clay">身份：{{persona}}</text>
  </view>

  <!-- One-liner gold quote -->
  <view wx:if="{{oneLiner}}" class="one-liner-card">
    <text class="one-liner-mark">"</text>
    <text class="one-liner-text">{{oneLiner}}</text>
    <text class="one-liner-mark one-liner-mark-right">"</text>
  </view>

  <!-- Identity tags -->
  <view wx:if="{{identityTags.length > 0}}" class="identity-tags-row">
    <text
      wx:for="{{identityTags}}"
      wx:key="*this"
      class="identity-tag"
    >{{item}}</text>
  </view>

  <!-- Stats grid -->
  <view class="stats-grid">
    <view class="stat-item">
      <text class="stat-num">{{stats.halls}}</text>
      <text class="stat-label text-muted">展厅</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{stats.exhibits}}</text>
      <text class="stat-label text-muted">展品</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{stats.messages}}</text>
      <text class="stat-label text-muted">互动</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{stats.duration}}</text>
      <text class="stat-label text-muted">时长</text>
    </view>
  </view>

  <!-- Radar / trait analysis (bar chart) -->
  <view wx:if="{{radarBars.length > 0}}" class="card">
    <text class="section-label text-clay text-bold">游览特质分析</text>
    <view class="radar-bars">
      <view
        wx:for="{{radarBars}}"
        wx:key="label"
        class="radar-bar-row"
      >
        <text class="radar-bar-label">{{item.label}}</text>
        <view class="radar-bar-track">
          <view class="radar-bar-fill" style="width: {{item.barWidth}}%;"></view>
        </view>
        <text class="radar-bar-value">{{item.value}}</text>
      </view>
    </view>
  </view>

  <!-- Highlights -->
  <view wx:if="{{highlights.length > 0}}" class="card">
    <text class="section-label text-clay text-bold">本次游览亮点</text>
    <view class="highlight-list">
      <view
        wx:for="{{highlights}}"
        wx:key="*this"
        class="highlight-row"
      >
        <text class="highlight-dot text-gold">◆</text>
        <text class="highlight-text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- Fallback notice (shown only when local demo data is used after API error) -->
  <view wx:if="{{loadError}}" class="error-notice">
    <text class="error-notice-text">⚠ 报告生成失败，当前显示为演示数据</text>
  </view>

  <!-- Actions -->
  <view class="report-actions">
    <button class="btn-primary"  bindtap="shareReport">分享报告</button>
    <button class="btn-secondary" style="margin-top:20rpx;" bindtap="goHome">返回首页</button>
  </view>

</view>
</scroll-view>
