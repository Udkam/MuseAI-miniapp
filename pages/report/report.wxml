<view wx:if="{{isLoading}}" class="report-loading">
  <text class="report-loading-icon">📋</text>
  <view class="report-loading-dots">
    <view class="rdot"></view>
    <view class="rdot"></view>
    <view class="rdot"></view>
  </view>
  <text class="report-loading-text">正在整理你的游览记录…</text>
</view>

<scroll-view wx:if="{{isReady}}" scroll-y class="report-scroll">
<view class="page-wrap report">

  <view class="report-header">
    <view class="archive-label">
      <text>本次参观记录</text>
    </view>
    <text class="report-title">{{reportTitle}}</text>
    <text wx:if="{{persona}}" class="report-persona">观察身份 · {{persona}}</text>
  </view>

  <view class="stats-grid">
    <view class="stat-item">
      <text class="stat-num">{{stats.exhibits}}</text>
      <text class="stat-label text-muted">展品</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{stats.messages}}</text>
      <text class="stat-label text-muted">问题</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{stats.duration}}</text>
      <text class="stat-label text-muted">时长</text>
    </view>
  </view>

  <view wx:if="{{canSaveReport}}" class="save-record-section">
    <view class="save-record-copy">
      <text class="save-record-title">保存本次记录</text>
      <text class="save-record-hint">复制为参观笔记，方便稍后回看</text>
    </view>
    <button class="save-record-button" bindtap="saveReportNote">复制记录</button>
  </view>

  <view wx:if="{{recordNotes.length > 0 || highlights.length > 0}}" class="record-section">
    <view class="record-heading">记录摘要</view>
    <view wx:if="{{recordNotes.length > 0}}" class="record-note-list">
      <view wx:for="{{recordNotes}}" wx:key="question" class="record-note">
        <text class="record-point" selectable="true" user-select="true">{{item.point}}</text>
      </view>
    </view>
    <view wx:elif="{{highlights.length > 0}}" class="highlight-list">
      <view wx:for="{{highlights}}" wx:key="*this" class="highlight-row">
        <text class="highlight-dot text-gold">◆</text>
        <text class="highlight-text">{{item}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{dataNotice || loadError}}" class="error-notice">
    <text class="error-notice-text">{{dataNotice}}</text>
  </view>

  <view class="report-actions">
    <button class="btn-primary" bindtap="continueExploring">继续探索</button>
    <button class="btn-secondary" style="margin-top:20rpx;" bindtap="goHome">返回首页</button>
  </view>

</view>
</scroll-view>
