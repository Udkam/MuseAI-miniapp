/* ── Page wrapper ─────────────────────────────────────────────────────────── */

.report {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.report-scroll {
  height: 100vh;
}

/* ── Loading screen ───────────────────────────────────────────────────────── */

.report-loading {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  background: #FAF7F2;
}

.report-loading-icon {
  font-size: 80rpx;
}

.report-loading-dots {
  display: flex;
  gap: 14rpx;
}

.rdot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #C4845A;
  animation: rdot-blink 1.2s infinite;
}

.rdot:nth-child(2) { animation-delay: 0.2s; }
.rdot:nth-child(3) { animation-delay: 0.4s; }

@keyframes rdot-blink {
  0%, 80%, 100% { opacity: 0.2; }
  40%            { opacity: 1; }
}

.report-loading-text {
  font-size: 28rpx;
  color: #8A6E55;
}

/* ── Header ───────────────────────────────────────────────────────────────── */

.report-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 40rpx;
}

.report-badge-icon {
  font-size: 88rpx;
  margin-bottom: 20rpx;
}

.report-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #3D2B1A;
  margin-bottom: 12rpx;
  text-align: center;
}

.report-persona {
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

/* ── One-liner gold quote ─────────────────────────────────────────────────── */

.one-liner-card {
  background: linear-gradient(135deg, #F5EDD8, #EDE0C4);
  border-radius: 20rpx;
  padding: 32rpx 36rpx;
  margin: 0 0 32rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  position: relative;
}

.one-liner-mark {
  font-size: 60rpx;
  color: #C4845A;
  line-height: 1;
  flex-shrink: 0;
  margin-top: -8rpx;
}

.one-liner-mark-right {
  align-self: flex-end;
  margin-top: 0;
  margin-bottom: -8rpx;
}

.one-liner-text {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #3D2B1A;
  line-height: 1.7;
  text-align: center;
  padding: 0 4rpx;
}

/* ── Identity tags (chip row) ─────────────────────────────────────────────── */

.identity-tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.identity-tag {
  font-size: 24rpx;
  color: #C4845A;
  background: #FFF5EE;
  border: 2rpx solid #C4845A44;
  border-radius: 100rpx;
  padding: 10rpx 28rpx;
  letter-spacing: 1rpx;
}

/* ── Stats grid ───────────────────────────────────────────────────────────── */

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  background: #F5F0E8;
  border-radius: 20rpx;
  padding: 32rpx 16rpx;
  margin-bottom: 32rpx;
  text-align: center;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #3D2B1A;
  display: block;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  display: block;
}

/* ── Section label ────────────────────────────────────────────────────────── */

.section-label {
  font-size: 28rpx;
  display: block;
  margin-bottom: 24rpx;
}

/* ── Radar bar chart ──────────────────────────────────────────────────────── */

.radar-bars {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.radar-bar-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.radar-bar-label {
  font-size: 24rpx;
  color: #5A3E2B;
  width: 112rpx;
  flex-shrink: 0;
  text-align: right;
}

.radar-bar-track {
  flex: 1;
  height: 16rpx;
  background: #EDE3D6;
  border-radius: 8rpx;
  overflow: hidden;
}

.radar-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #C4845A, #E8A878);
  border-radius: 8rpx;
  transition: width 0.6s ease-out;
  min-width: 4rpx;
}

.radar-bar-value {
  font-size: 24rpx;
  color: #8A6E55;
  width: 56rpx;
  text-align: right;
  flex-shrink: 0;
}

/* ── Highlights ───────────────────────────────────────────────────────────── */

.highlight-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.highlight-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.highlight-dot {
  font-size: 18rpx;
  margin-top: 8rpx;
  flex-shrink: 0;
}

.highlight-text {
  font-size: 28rpx;
  color: #5A3E2B;
  line-height: 1.6;
  flex: 1;
}

/* ── Error notice (fallback indicator) ───────────────────────────────────── */

.error-notice {
  text-align: center;
  padding: 24rpx 0 8rpx;
}

.error-notice-text {
  font-size: 22rpx;
  color: #B08060;
  display: block;
}

/* ── Actions ──────────────────────────────────────────────────────────────── */

.report-actions {
  padding: 16rpx 0 60rpx;
}
