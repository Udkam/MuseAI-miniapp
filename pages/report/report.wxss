.report-scroll {
  height: 100vh;
  background: #F8F3EA;
}

.report {
  min-height: 100vh;
  padding: 48rpx 36rpx calc(64rpx + constant(safe-area-inset-bottom));
  padding: 48rpx 36rpx calc(64rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.report-loading {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  background: #F8F3EA;
}

.report-loading-icon {
  font-size: 80rpx;
  line-height: 1;
}

.report-loading-dots {
  display: flex;
  gap: 12rpx;
}

.rdot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 2rpx;
  background: #A85732;
  animation: rdot-blink 1.2s infinite;
}

.rdot:nth-child(2) { animation-delay: 0.2s; }
.rdot:nth-child(3) { animation-delay: 0.4s; }

@keyframes rdot-blink {
  0%, 80%, 100% { opacity: 0.2; }
  40% { opacity: 1; }
}

.report-loading-text {
  color: #7C6654;
  font-size: 26rpx;
}

.report-header {
  padding: 12rpx 0 40rpx;
  border-bottom: 2rpx solid #D8C8B4;
}

.archive-label {
  display: block;
  color: #A85732;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: 28rpx;
}

.report-title {
  display: block;
  color: #3F2A1D;
  font-family: 'Songti SC', 'STSong', serif;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.3;
}

.report-persona {
  display: block;
  color: #A85732;
  font-size: 23rpx;
  letter-spacing: 1rpx;
  margin-top: 12rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin: 32rpx 0 48rpx;
  border-top: 2rpx solid #E6D8C6;
  border-left: 2rpx solid #E6D8C6;
}

.stat-item {
  min-height: 112rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 16rpx 22rpx;
  background: #FFF9F1;
  border-right: 2rpx solid #E6D8C6;
  border-bottom: 2rpx solid #E6D8C6;
  box-sizing: border-box;
}

.stat-num {
  color: #3F2A1D;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.25;
}

.stat-label {
  color: #7C6654;
  font-size: 21rpx;
  margin-top: 4rpx;
}

.save-record-section {
  margin-bottom: 48rpx;
  padding: 24rpx 26rpx;
  background: #F3EADD;
  border-left: 5rpx solid #A85732;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.save-record-copy {
  flex: 1;
  min-width: 0;
}

.save-record-title {
  display: block;
  color: #A85732;
  font-family: 'Songti SC', 'STSong', serif;
  font-size: 30rpx;
  font-weight: 700;
}

.save-record-hint {
  display: block;
  color: #7C6654;
  font-size: 22rpx;
  line-height: 1.5;
  margin-top: 8rpx;
}

.save-record-button {
  width: auto;
  min-width: 152rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5A3E2B;
  background: #FFF9F1;
  border: 2rpx solid #D8C8B4;
  border-radius: 2rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
  box-sizing: border-box;
}

.save-record-button::after {
  border: 0;
}

.save-record-button:active {
  background: #EFE5D8;
}

.record-section {
  margin-bottom: 48rpx;
}

.record-heading {
  color: #3F2A1D;
  font-family: 'Songti SC', 'STSong', serif;
  font-size: 32rpx;
  font-weight: 700;
  padding-bottom: 14rpx;
  border-bottom: 2rpx solid #D8C8B4;
  margin-bottom: 22rpx;
}

.record-note-list,
.highlight-list {
  display: flex;
  flex-direction: column;
}

.record-note,
.highlight-row {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #E6D8C6;
}

.record-point,
.highlight-text {
  display: block;
  color: #5A3E2B;
  font-size: 26rpx;
  line-height: 1.8;
}

.highlight-row {
  display: grid;
  grid-template-columns: 30rpx 1fr;
  gap: 14rpx;
}

.highlight-dot {
  color: #A85732;
  font-size: 17rpx;
  margin-top: 8rpx;
}

.error-notice {
  background: #FFF9F1;
  border: 2rpx solid #E6D8C6;
  border-left: 6rpx solid #A85732;
  padding: 20rpx 22rpx;
  margin-bottom: 32rpx;
}

.error-notice-text {
  display: block;
  color: #8A6E55;
  font-size: 24rpx;
  line-height: 1.6;
}

.report-actions {
  padding: 8rpx 0 calc(24rpx + constant(safe-area-inset-bottom));
  padding: 8rpx 0 calc(24rpx + env(safe-area-inset-bottom));
}
