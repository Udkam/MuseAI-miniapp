/* ── Page wrapper ─────────────────────────────────────────────────────────── */

.report {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.report-scroll {
  height: 100vh;
}

/* ── Loading screen ───────────────────────────────────────────────────────── */

.report-loading {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  background: #FAF7F2;
}

.report-loading-icon {
  font-size: 80rpx;
}

.report-loading-dots {
  display: flex;
  gap: 14rpx;
}

.rdot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #C4845A;
  animation: rdot-blink 1.2s infinite;
}

.rdot:nth-child(2) { animation-delay: 0.2s; }
.rdot:nth-child(3) { animation-delay: 0.4s; }

@keyframes rdot-blink {
  0%, 80%, 100% { opacity: 0.2; }
  40%            { opacity: 1; }
}

.report-loading-text {
  font-size: 28rpx;
  color: #8A6E55;
}

/* ── Header ───────────────────────────────────────────────────────────────── */

.report-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 40rpx;
}

.report-badge-icon {
  font-size: 88rpx;
  margin-bottom: 20rpx;
}

.report-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #3D2B1A;
  margin-bottom: 12rpx;
  text-align: center;
}

.report-persona {
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

/* ── Stats grid ───────────────────────────────────────────────────────────── */

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  background: #F5F0E8;
  border-radius: 20rpx;
  padding: 32rpx 16rpx;
  margin-bottom: 32rpx;
  text-align: center;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #3D2B1A;
  display: block;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  display: block;
}

/* ── Section label ────────────────────────────────────────────────────────── */

.section-label {
  font-size: 28rpx;
  display: block;
  margin-bottom: 24rpx;
}

.summary-card {
  background: #FFFDF9;
}

.summary-text {
  display: block;
  font-size: 28rpx;
  color: #5A3E2B;
  line-height: 1.75;
}

.reflection-card {
  background: #FFFDF9;
}

.reflection-row {
  display: grid;
  grid-template-columns: 84rpx 1fr;
  gap: 18rpx;
  padding: 18rpx 0;
  border-top: 2rpx solid #F0E2D5;
}

.reflection-row:first-of-type {
  border-top: 0;
  padding-top: 0;
}

.reflection-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #C4845A;
  line-height: 1.7;
}

.reflection-text {
  font-size: 27rpx;
  color: #5A3E2B;
  line-height: 1.7;
}

.hall-card-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.hall-summary-row {
  padding: 22rpx 24rpx;
  background: #FFF8EF;
  border-radius: 14rpx;
  border: 2rpx solid #EAD9C9;
}

.hall-summary-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #3D2B1A;
  margin-bottom: 8rpx;
}

.hall-summary-note {
  display: block;
  font-size: 25rpx;
  color: #8A6E55;
  line-height: 1.55;
}

.question-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.question-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 18rpx 20rpx;
  background: #F5F0E8;
  border-radius: 14rpx;
}

.question-mark {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  background: #C4845A;
  color: #FFF8EF;
  font-size: 22rpx;
  line-height: 40rpx;
  text-align: center;
  flex-shrink: 0;
}

.question-text {
  flex: 1;
  color: #5A3E2B;
  font-size: 26rpx;
  line-height: 1.6;
}

/* ── Review checklist ─────────────────────────────────────────────────────── */

.review-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.review-row {
  padding: 22rpx 24rpx;
  background: #FFF8EF;
  border-radius: 14rpx;
  border: 2rpx solid #EAD9C9;
}

.review-label {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #C4845A;
  margin-bottom: 8rpx;
}

.review-text {
  display: block;
  font-size: 26rpx;
  color: #5A3E2B;
  line-height: 1.6;
}

/* ── Highlights ───────────────────────────────────────────────────────────── */

.highlight-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.highlight-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.highlight-dot {
  font-size: 18rpx;
  margin-top: 8rpx;
  flex-shrink: 0;
}

.highlight-text {
  font-size: 28rpx;
  color: #5A3E2B;
  line-height: 1.6;
  flex: 1;
}

.compact-card {
  background: #F8F2EA;
}

/* ── Error notice (fallback indicator) ───────────────────────────────────── */

.error-notice {
  background: #FFF8EF;
  border-left: 6rpx solid #C4845A;
  border-radius: 0 14rpx 14rpx 0;
  padding: 18rpx 22rpx;
  margin-bottom: 24rpx;
}

.error-notice-text {
  font-size: 24rpx;
  color: #B08060;
  display: block;
  line-height: 1.6;
}

/* ── Actions ──────────────────────────────────────────────────────────────── */

.report-actions {
  padding: 16rpx 0 60rpx;
}
