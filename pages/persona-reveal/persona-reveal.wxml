<view class="page-wrap reveal" wx:if="{{persona}}">
  <view class="reveal-shell">
    <view class="reveal-heading">
      <text class="reveal-kicker">MuseAI 已整理完成</text>
      <text class="reveal-title">你的导览身份</text>
    </view>

    <view class="pass-card" style="border-color: {{persona.color}};">
      <view class="pass-head">
        <view class="persona-mark" style="background-color: {{persona.color}};">
          <image wx:if="{{persona.iconSrc}}" class="persona-icon-img" src="{{persona.iconSrc}}" mode="aspectFit" binderror="onPersonaIconError"></image>
          <text wx:else class="persona-icon">{{persona.icon}}</text>
        </view>
        <view class="pass-title-block">
          <text class="pass-label">今日观察视角</text>
          <text class="persona-title" style="color: {{persona.color}};">{{persona.label}}</text>
        </view>
      </view>

      <text class="persona-desc">{{persona.desc}}</text>

      <view class="pass-divider"></view>

      <view class="ai-brief">
        <text class="ai-brief-label">AI 会优先</text>
        <text class="ai-brief-text">{{persona.aiDesc}}</text>
      </view>
    </view>

    <view class="route-card">
      <view class="route-card-head">
        <text class="route-title">接下来这样逛</text>
        <text class="route-sub">提问和报告会按这个视角组织</text>
      </view>

      <view class="route-track">
        <view wx:for="{{routeTips}}" wx:key="title" class="route-node">
          <text class="route-index" style="background-color: {{persona.color}};">{{index + 1}}</text>
          <text class="route-node-title">{{item.title}}</text>
        </view>
      </view>

      <view wx:if="{{hasEntryProfile}}" class="profile-strip">
        <view wx:if="{{focusTitle}}" class="profile-item">
          <text class="profile-key">追问</text>
          <text class="profile-value">{{focusTitle}}</text>
        </view>
        <view wx:if="{{guideModeTitle}}" class="profile-item">
          <text class="profile-key">节奏</text>
          <text class="profile-value">{{guideModeTitle}}</text>
        </view>
      </view>
    </view>

    <view class="next-flow">
      <view class="flow-item">
        <text class="flow-label">先看展厅</text>
        <text class="flow-desc">选择参观区域</text>
      </view>
      <view class="flow-divider"></view>
      <view class="flow-item">
        <text class="flow-label">再到现场</text>
        <text class="flow-desc">从眼前展品开始</text>
      </view>
      <view class="flow-divider"></view>
      <view class="flow-item">
        <text class="flow-label">边看边问</text>
        <text class="flow-desc">生成游览报告</text>
      </view>
    </view>

    <view class="bottom-action">
      <button
        class="btn-primary reveal-cta"
        bindtap="goHall"
      >查看展厅列表 →</button>
    </view>
  </view>
</view>
