<view class="page-wrap reveal" wx:if="{{persona}}">

  <view class="reveal-top">
    <text class="reveal-hint text-muted text-sm">根据你的回答，</text>
  </view>

  <!-- Persona card -->
  <view class="persona-card" style="border-color: {{persona.color}}">
    <text class="persona-icon">{{persona.icon}}</text>
    <text class="persona-title" style="color: {{persona.color}}">{{persona.title}}</text>
    <text class="persona-desc">{{persona.desc}}</text>
  </view>

  <!-- Badge -->
  <view class="badge-row">
    <view class="badge" style="background: {{persona.color}}">
      <text class="badge-text">{{persona.label}}</text>
    </view>
  </view>

  <!-- AI behavior description -->
  <view class="ai-behavior-block">
    <text class="ai-behavior-label">AI 导览员会这样陪你</text>
    <view class="ai-behavior-bubble">
      <text class="ai-behavior-text">{{persona.aiDesc}}</text>
    </view>
  </view>

  <!-- Onboarding profile preview -->
  <view wx:if="{{hasEntryProfile}}" class="entry-profile-block">
    <text class="entry-profile-label">你的导览档案</text>
    <view class="entry-profile-row" wx:if="{{focusTitle}}">
      <text class="entry-profile-key">追问方向</text>
      <text class="entry-profile-value">{{focusTitle}}</text>
    </view>
    <view class="entry-profile-row" wx:if="{{guideModeTitle}}">
      <text class="entry-profile-key">导览节奏</text>
      <text class="entry-profile-value">{{guideModeTitle}}</text>
    </view>
  </view>

  <!-- Assumption challenge preview -->
  <view wx:if="{{assumptionHint}}" class="challenge-preview">
    <text class="challenge-icon">💡</text>
    <text class="challenge-text">{{assumptionHint}}</text>
  </view>

  <!-- Preferred hall recommendation -->
  <view wx:if="{{preferredHall}}" class="preferred-hall-block">
    <text class="preferred-hall-label">为你优先推荐</text>
    <view class="preferred-hall-row">
      <text class="preferred-hall-arrow">▶</text>
      <view class="preferred-hall-info">
        <text class="preferred-hall-name">{{preferredHall}}</text>
        <text class="preferred-hall-desc">{{preferredHallDesc}}</text>
      </view>
    </view>
  </view>

  <view class="bottom-action">
    <button class="btn-primary" bindtap="goHall">进入展厅 →</button>
  </view>

</view>
