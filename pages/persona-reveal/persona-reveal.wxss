.reveal {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
}

.reveal-top {
  padding: 40rpx 0 32rpx;
  width: 100%;
}

/* ── Persona card ───────────────────────────────────────────────────────────── */

.persona-card {
  width: 100%;
  background: #F5F0E8;
  border: 4rpx solid #C4845A;
  border-radius: 24rpx;
  padding: 56rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
  box-sizing: border-box;
}

.persona-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.persona-title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 32rpx;
  text-align: center;
}

.persona-desc {
  font-size: 28rpx;
  color: #5A3E2B;
  line-height: 1.8;
  text-align: center;
}

/* ── Badge ──────────────────────────────────────────────────────────────────── */

.badge-row {
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.badge {
  padding: 12rpx 40rpx;
  border-radius: 100rpx;
}

.badge-text {
  color: #FAF7F2;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

/* ── AI behavior description ────────────────────────────────────────────────── */

.ai-behavior-block {
  width: 100%;
  margin-bottom: 24rpx;
}

.ai-behavior-label {
  font-size: 22rpx;
  color: #B08060;
  display: block;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.ai-behavior-bubble {
  background: #F5F0E8;
  border-left: 6rpx solid #C4845A;
  border-radius: 0 16rpx 16rpx 0;
  padding: 24rpx 28rpx;
}

.ai-behavior-text {
  font-size: 28rpx;
  color: #3D2B1A;
  line-height: 1.7;
}

/* ── Challenge preview ──────────────────────────────────────────────────────── */

.challenge-preview {
  width: 100%;
  background: #FFFBF5;
  border: 2rpx solid #EDD8B8;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 40rpx;
  box-sizing: border-box;
}

.challenge-icon {
  font-size: 36rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.challenge-text {
  font-size: 26rpx;
  color: #8A6E55;
  line-height: 1.65;
  flex: 1;
}

/* ── Preferred hall block ───────────────────────────────────────────────────── */

.preferred-hall-block {
  width: 100%;
  background: #F5F0E8;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 40rpx;
  box-sizing: border-box;
}

.preferred-hall-label {
  font-size: 22rpx;
  color: #B08060;
  display: block;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.preferred-hall-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.preferred-hall-arrow {
  font-size: 28rpx;
  color: #C4845A;
  font-weight: 700;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.preferred-hall-info {
  flex: 1;
}

.preferred-hall-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C1810;
  display: block;
  margin-bottom: 6rpx;
}

.preferred-hall-desc {
  font-size: 24rpx;
  color: #8A6E55;
  line-height: 1.5;
}

/* ── Bottom action ──────────────────────────────────────────────────────────── */

.bottom-action {
  width: 100%;
  margin-top: auto;
  padding-bottom: 60rpx;
}

.entry-profile-block {
  width: 100%;
  background: #FFFBF5;
  border: 2rpx solid #EAD9C2;
  border-radius: 16rpx;
  padding: 22rpx 28rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.entry-profile-label {
  display: block;
  font-size: 22rpx;
  color: #B08060;
  margin-bottom: 14rpx;
}

.entry-profile-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 10rpx;
}

.entry-profile-key {
  color: #8A6E55;
  font-size: 24rpx;
  flex-shrink: 0;
}

.entry-profile-value {
  color: #3D2B1A;
  font-size: 24rpx;
  font-weight: 600;
  text-align: right;
  word-break: break-all;
}
