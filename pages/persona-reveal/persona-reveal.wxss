page {
  height: 100%;
  overflow: hidden;
  background: #FAF7F2;
}

.reveal {
  height: 100vh;
  min-height: 0;
  overflow: hidden;
  padding: 28rpx 32rpx 34rpx;
  box-sizing: border-box;
}

.reveal-shell {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.reveal-heading {
  padding: 6rpx 0 22rpx;
  flex-shrink: 0;
}

.reveal-kicker {
  display: block;
  color: #B08060;
  font-size: 22rpx;
  line-height: 1.4;
}

.reveal-title {
  display: block;
  color: #2C1810;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.25;
  margin-top: 4rpx;
}

.pass-card {
  width: 100%;
  background: #FFFBF5;
  border: 3rpx solid #C4845A;
  border-radius: 26rpx;
  padding: 30rpx 30rpx 26rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 34rpx rgba(61, 43, 26, 0.06);
  flex-shrink: 0;
}

.pass-head {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.persona-mark {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 -8rpx 0 rgba(44, 24, 16, 0.08);
  flex-shrink: 0;
}

.persona-icon {
  color: #FFF8EF;
  font-size: 48rpx;
  line-height: 1;
}

.pass-title-block {
  min-width: 0;
  flex: 1;
}

.pass-label {
  display: block;
  color: #8A6E55;
  font-size: 22rpx;
  line-height: 1.3;
}

.persona-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.25;
  margin-top: 4rpx;
}

.persona-desc {
  display: block;
  color: #5A3E2B;
  font-size: 26rpx;
  line-height: 1.65;
  margin-top: 24rpx;
}

.pass-divider {
  height: 2rpx;
  background: #EAD9C2;
  margin: 24rpx 0 20rpx;
}

.ai-brief {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
}

.ai-brief-label {
  color: #C4845A;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
  line-height: 1.55;
}

.ai-brief-text {
  color: #3D2B1A;
  font-size: 24rpx;
  line-height: 1.55;
  flex: 1;
}

.route-card {
  margin-top: 22rpx;
  width: 100%;
  background: #F5F0E8;
  border-radius: 24rpx;
  padding: 24rpx 26rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.route-card-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.route-title {
  color: #2C1810;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.25;
  flex-shrink: 0;
}

.route-sub {
  color: #8A6E55;
  font-size: 20rpx;
  line-height: 1.3;
  text-align: right;
}

.route-track {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.route-node {
  flex: 1;
  min-width: 0;
  background: #FFFBF5;
  border-radius: 18rpx;
  padding: 16rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.route-index {
  width: 34rpx;
  height: 34rpx;
  border-radius: 17rpx;
  color: #FFF8EF;
  font-size: 20rpx;
  line-height: 34rpx;
  text-align: center;
  font-weight: 700;
}

.route-node-title {
  color: #3D2B1A;
  font-size: 23rpx;
  line-height: 1.25;
  font-weight: 700;
  white-space: nowrap;
}

.profile-strip {
  margin-top: 18rpx;
  border-top: 2rpx solid #EAD9C2;
  padding-top: 16rpx;
  display: flex;
  gap: 16rpx;
}

.profile-item {
  flex: 1;
  min-width: 0;
}

.profile-key {
  display: block;
  color: #B08060;
  font-size: 20rpx;
  line-height: 1.3;
}

.profile-value {
  display: block;
  color: #3D2B1A;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.next-flow {
  margin-top: 22rpx;
  width: 100%;
  background: #FFFBF5;
  border: 2rpx solid #EAD9C2;
  border-radius: 20rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.flow-item {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.flow-label {
  display: block;
  color: #3D2B1A;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
}

.flow-desc {
  display: block;
  color: #8A6E55;
  font-size: 20rpx;
  line-height: 1.35;
  margin-top: 4rpx;
  white-space: nowrap;
}

.flow-divider {
  width: 2rpx;
  height: 46rpx;
  background: #EAD9C2;
  margin: 0 12rpx;
  flex-shrink: 0;
}

.bottom-action {
  width: 440rpx;
  max-width: 100%;
  align-self: center;
  margin-top: auto;
  padding: 24rpx 0 58rpx;
  flex-shrink: 0;
}

.bottom-action .reveal-cta {
  border-radius: 16rpx;
  box-shadow: 0 12rpx 24rpx rgba(61, 43, 26, 0.16);
}
