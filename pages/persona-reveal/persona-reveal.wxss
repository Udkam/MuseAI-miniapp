.reveal {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
}

.reveal-top {
  padding: 40rpx 0 32rpx;
  width: 100%;
}

.persona-card {
  width: 100%;
  background: #F5F0E8;
  border: 4rpx solid #C4845A;
  border-radius: 24rpx;
  padding: 56rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
  box-sizing: border-box;
}

.persona-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.persona-title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 32rpx;
  text-align: center;
}

.persona-desc {
  font-size: 28rpx;
  color: #5A3E2B;
  line-height: 1.8;
  text-align: center;
}

.badge-row {
  display: flex;
  justify-content: center;
  margin-bottom: 60rpx;
}

.badge {
  padding: 12rpx 40rpx;
  border-radius: 100rpx;
}

.badge-text {
  color: #FAF7F2;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.bottom-action {
  width: 100%;
  margin-top: auto;
  padding-bottom: 60rpx;
}
