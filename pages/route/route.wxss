.route {
  min-height: 100vh;
}

.route-header {
  padding: 16rpx 0 40rpx;
}

.route-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #3D2B1A;
  display: block;
  margin-bottom: 12rpx;
}

.route-total {
  display: block;
}

.timeline {
  display: flex;
  flex-direction: column;
}

.timeline-item {
  display: flex;
  gap: 24rpx;
}

.timeline-line-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  width: 48rpx;
}

.timeline-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #C4845A;
  color: #FAF7F2;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.timeline-connector {
  flex: 1;
  width: 4rpx;
  background: #DDD0C0;
  margin: 8rpx 0;
  min-height: 40rpx;
}

.timeline-card {
  flex: 1;
  margin-bottom: 32rpx;
  padding: 28rpx;
}

.card-header-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.tl-icon {
  font-size: 48rpx;
}

.tl-hall {
  font-size: 32rpx;
  font-weight: 600;
  color: #3D2B1A;
  display: block;
  margin-bottom: 4rpx;
}

.tl-duration {
  display: block;
}

.highlights {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.highlight-tag {
  font-size: 24rpx;
  color: #C4845A;
  background: #C4845A18;
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
}
