<view class="page-wrap route-page" wx:if="{{loaded}}">

  <view class="route-header">
    <text class="route-title">展厅列表</text>
    <text wx:if="{{routeNotice}}" class="route-notice">{{routeNotice}}</text>
  </view>

  <view class="steps-section">
    <view class="steps-list">
      <view
        wx:for="{{steps}}"
        wx:key="hallId"
        class="step-wrap"
        style="animation-delay: {{index * 80}}ms"
      >
        <view class="step-rail">
          <view class="step-node step-node-upcoming">
            <text class="step-node-num">{{item.order}}</text>
          </view>
          <view
            wx:if="{{index < stepsCount - 1}}"
            class="step-conn-line step-conn-line-upcoming"
          ></view>
        </view>

        <view class="step-card step-card-upcoming">
          <view class="step-title-row">
            <text class="step-hall-name step-hall-name-upcoming">{{item.name}}</text>
            <text class="step-duration">{{item.duration}}</text>
          </view>

          <view class="step-reason-block">
            <text class="step-reason-label">简介</text>
            <text class="step-reason-text">{{item.reason}}</text>
          </view>

          <view class="step-highlights">
            <text
              wx:for="{{item.highlights}}"
              wx:key="*this"
              wx:for-item="h"
              class="step-tag step-tag-upcoming"
            >{{h}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-action">
    <button class="btn-primary" bindtap="startTour">选择展厅</button>
  </view>
</view>
