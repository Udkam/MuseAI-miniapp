.scan {
  min-height: 100vh;
}

.camera-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F5F0E8;
  border: 3rpx dashed #C4845A;
  border-radius: 24rpx;
  padding: 80rpx 40rpx;
  margin-bottom: 0;
}

.camera-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.camera-hint {
  font-size: 32rpx;
  font-weight: 600;
  color: #3D2B1A;
  margin-bottom: 12rpx;
}

.camera-sub {
  display: block;
}

.divider {
  display: flex;
  align-items: center;
  margin: 48rpx 0;
}

.divider::before,
.divider::after {
  content: '';
  flex: 1;
  height: 2rpx;
  background: #DDD0C0;
}

.divider-text {
  padding: 0 24rpx;
}

.name-input-block {
  display: flex;
  flex-direction: column;
}

.input-label {
  font-size: 28rpx;
  display: block;
  margin-bottom: 16rpx;
}

.name-input {
  background: #F5F0E8;
  border: 2rpx solid #DDD0C0;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  color: #2C1810;
}
