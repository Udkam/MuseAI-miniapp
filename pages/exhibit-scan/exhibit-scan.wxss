.scan {
  min-height: 100vh;
}

/* ── Header ──────────────────────────────────────────────────────────────── */

.scan-header {
  padding: 32rpx 0 24rpx;
}

.scan-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #3F2A1D;
  display: block;
  margin-bottom: 8rpx;
}

.scan-hint {
  display: block;
}

/* ── Search bar ───────────────────────────────────────────────────────────── */

.search-bar {
  display: flex;
  align-items: center;
  background: #F3EADD;
  border: 2rpx solid #D8C8B4;
  border-radius: 100rpx;
  padding: 16rpx 28rpx;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.search-icon {
  font-size: 30rpx;
  line-height: 1;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #241712;
}

.search-clear {
  flex-shrink: 0;
  color: #7C6654;
  font-size: 28rpx;
  padding: 4rpx 8rpx;
}

.data-notice {
  background: #FFF9F1;
  border-left: 6rpx solid #A85732;
  color: #8A6E55;
  font-size: 24rpx;
  line-height: 1.6;
  padding: 18rpx 22rpx;
  margin: -8rpx 0 28rpx;
  border-radius: 0 14rpx 14rpx 0;
}

.scan-action-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #FFF9F1;
  border: 2rpx solid #E7D2BE;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  margin: -12rpx 0 24rpx;
}

.scan-action-text {
  flex: 1;
  min-width: 0;
}

.scan-action-title {
  display: block;
  color: #3F2A1D;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.scan-action-desc {
  display: block;
  color: #8A6E55;
  font-size: 23rpx;
  line-height: 1.5;
}

.scan-photo-btn {
  flex-shrink: 0;
  min-width: 156rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #4A2F1C;
  color: #FFF9F1;
  font-size: 25rpx;
  font-weight: 600;
}

.scan-photo-btn[disabled] {
  opacity: 0.72;
}

.scan-notice {
  color: #9A7458;
  font-size: 24rpx;
  line-height: 1.6;
  margin: -8rpx 0 20rpx;
}

.scan-result-card {
  background: #F7EFE6;
  border: 2rpx solid #D9B18E;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.scan-result-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.scan-result-label,
.scan-result-confidence {
  color: #A85732;
  font-size: 23rpx;
  font-weight: 600;
}

.scan-result-name {
  display: block;
  color: #241712;
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.scan-result-desc {
  display: block;
  color: #6F5947;
  font-size: 25rpx;
  line-height: 1.65;
  margin-bottom: 14rpx;
}

.scan-result-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.scan-result-open {
  display: block;
  color: #8B4F2D;
  font-size: 25rpx;
  font-weight: 600;
  text-align: right;
}

/* ── Exhibit list ─────────────────────────────────────────────────────────── */

.exhibit-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 48rpx;
}

.exhibit-card {
  display: flex;
  align-items: center;
  background: #F3EADD;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  gap: 20rpx;
}

.exhibit-card-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 22rpx;
  background: #FFF9F1;
  border: 2rpx solid #E6D8C6;
  font-size: 40rpx;
  line-height: 64rpx;
  text-align: center;
  flex-shrink: 0;
}

.exhibit-card-info {
  flex: 1;
  overflow: hidden;
}

.exhibit-card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #241712;
  display: block;
  margin-bottom: 12rpx;
}

.exhibit-card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.etag {
  font-size: 22rpx;
  color: #7C6654;
  background: #E7D8C5;
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
}

.etag-era {
  background: #A8573222;
  color: #A85732;
}

.exhibit-card-arrow {
  font-size: 44rpx;
  flex-shrink: 0;
}

/* ── States ───────────────────────────────────────────────────────────────── */

.state-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  gap: 16rpx;
}

.empty-icon {
  font-size: 72rpx;
  line-height: 1;
}

.empty-text {
  font-size: 30rpx;
}

/* ── Manual input fallback ────────────────────────────────────────────────── */

.manual-section {
  border-top: 2rpx solid #D8C8B4;
  padding-top: 32rpx;
  margin-top: 8rpx;
}

.manual-label {
  display: block;
  margin-bottom: 16rpx;
}

.manual-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.manual-input {
  flex: 1;
  background: #F3EADD;
  border: 2rpx solid #D8C8B4;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #241712;
}

.manual-btn {
  background: #A85732;
  color: #F8F3EA;
  font-size: 26rpx;
  padding: 20rpx 32rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  line-height: 1.4;
}
