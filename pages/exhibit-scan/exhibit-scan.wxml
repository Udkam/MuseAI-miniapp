<view class="page-wrap scan">

  <view class="scan-header">
    <text class="scan-title">展品浏览</text>
    <text class="scan-hint text-muted text-sm">{{hallHint}}</text>
  </view>

  <!-- Search bar -->
  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      value="{{searchText}}"
      placeholder="搜索展品名称"
      bindinput="onSearchInput"
      confirm-type="search"
      bindconfirm="doSearch"
    />
    <view wx:if="{{searchText}}" class="search-clear" bindtap="clearSearch">
      <text>✕</text>
    </view>
  </view>

  <!-- Loading -->
  <view wx:if="{{loading}}" class="state-wrap">
    <text class="text-muted text-sm">加载展品中…</text>
  </view>

  <!-- Exhibit list -->
  <view wx:elif="{{exhibits.length}}" class="exhibit-list">
    <view
      wx:for="{{exhibits}}"
      wx:key="id"
      class="exhibit-card"
      bindtap="selectExhibit"
      data-exhibit="{{item}}"
    >
      <view class="exhibit-card-icon">🏺</view>
      <view class="exhibit-card-info">
        <text class="exhibit-card-name">{{item.name}}</text>
        <view class="exhibit-card-tags">
          <text wx:if="{{item.hallDisplay}}" class="etag">{{item.hallDisplay}}</text>
          <text wx:if="{{item.category}}"    class="etag">{{item.category}}</text>
          <text wx:if="{{item.era}}"         class="etag etag-era">{{item.era}}</text>
        </view>
      </view>
      <text class="exhibit-card-arrow text-clay">›</text>
    </view>
  </view>

  <!-- Empty state -->
  <view wx:elif="{{!loading}}" class="state-wrap">
    <text class="empty-icon">🔍</text>
    <text class="empty-text text-muted">没有找到相关展品</text>
    <text class="text-muted text-sm" style="display:block;margin-top:8rpx;">换个关键词试试</text>
  </view>

</view>
