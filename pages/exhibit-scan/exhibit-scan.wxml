<view class="page-wrap scan">

  <view class="scan-header">
    <text class="scan-title">展品浏览</text>
    <text class="scan-hint text-muted text-sm">{{hallHint}}</text>
  </view>

  <!-- Search bar -->
  <view class="search-bar">
    <image class="search-icon-img" src="/assets/icons/action-search-exhibit.png" mode="aspectFit"></image>
    <input
      class="search-input"
      value="{{searchText}}"
      placeholder="搜索展品名称"
      bindinput="onSearchInput"
      confirm-type="search"
      bindconfirm="doSearch"
    />
    <view wx:if="{{searchText}}" class="search-clear" bindtap="clearSearch">
      <text>✕</text>
    </view>
  </view>

  <view class="scan-action-card">
    <view class="scan-action-text">
      <text class="scan-action-title">拍照识别展品</text>
      <text class="scan-action-desc">对准展签或展品名称拍照，MuseAI 会尝试匹配最接近的展品。</text>
    </view>
    <button class="scan-photo-btn" loading="{{scanning}}" disabled="{{scanning}}" bindtap="startPhotoScan">
      {{scanning ? '识别中…' : '拍照识别'}}
    </button>
  </view>

  <view wx:if="{{scanNotice}}" class="scan-notice">
    <text>{{scanNotice}}</text>
  </view>

  <view wx:if="{{scanResult}}" class="scan-result-card" bindtap="openScanResult">
    <view class="scan-result-top">
      <text class="scan-result-label">识别结果</text>
      <text class="scan-result-confidence">匹配度：{{scanResult.confidence}}</text>
    </view>
    <text class="scan-result-name">{{scanResult.name}}</text>
    <text wx:if="{{scanResult.description}}" class="scan-result-desc" selectable="{{true}}" user-select="{{true}}">{{scanResult.description}}</text>
    <view class="scan-result-tags">
      <text wx:if="{{scanResult.hallDisplay}}" class="etag">{{scanResult.hallDisplay}}</text>
      <text wx:if="{{scanResult.category}}" class="etag">{{scanResult.category}}</text>
    </view>
    <text class="scan-result-open">查看详情 ›</text>
  </view>

  <view wx:if="{{dataNotice}}" class="data-notice">
    <text>{{dataNotice}}</text>
  </view>

  <!-- Loading -->
  <view wx:if="{{loading}}" class="state-wrap">
    <text class="text-muted text-sm">加载展品中…</text>
  </view>

  <!-- Exhibit list -->
  <view wx:elif="{{exhibits.length}}" class="exhibit-list">
    <view
      wx:for="{{exhibits}}"
      wx:key="id"
      class="exhibit-card"
      bindtap="selectExhibit"
      data-exhibit="{{item}}"
    >
      <image class="exhibit-card-icon-img" src="/assets/icons/exhibit-list-item.png" mode="aspectFit"></image>
      <view class="exhibit-card-info">
        <text class="exhibit-card-name">{{item.name}}</text>
        <view class="exhibit-card-tags">
          <text wx:if="{{item.hallDisplay}}" class="etag">{{item.hallDisplay}}</text>
          <text wx:if="{{item.category}}"    class="etag">{{item.category}}</text>
          <text wx:if="{{item.era}}"         class="etag etag-era">{{item.era}}</text>
          <text wx:if="{{item.isLocalFallback}}" class="etag">本地示例</text>
        </view>
      </view>
      <text class="exhibit-card-arrow text-clay">›</text>
    </view>
  </view>

  <!-- Empty state -->
  <view wx:elif="{{!loading}}" class="state-wrap">
    <image class="empty-icon-img" src="/assets/icons/exhibit-empty-search.png" mode="aspectFit"></image>
    <text class="empty-text text-muted">没有找到匹配展品</text>
    <text class="text-muted text-sm" style="display:block;margin-top:8rpx;">可以换成“陶器”“房屋”“墓葬”等关键词</text>
  </view>

</view>
