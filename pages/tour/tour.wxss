.tour-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #FAF7F2;
  overflow: hidden;
}

/* ── Top bar ─────────────────────────────────────────────────────────────── */

.tour-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background: #F5F0E8;
  border-bottom: 2rpx solid #DDD0C0;
  flex-shrink: 0;
}

.topbar-hall {
  font-size: 28rpx;
  font-weight: 600;
  color: #3D2B1A;
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.topbar-btn {
  font-size: 26rpx;
  color: #C4845A;
}

.topbar-btn-ping {
  color: #7A9B6E;
}

.topbar-sep {
  font-size: 24rpx;
  color: #DDD0C0;
}

/* ── Exhibit Context Bar ─────────────────────────────────────────────────── */

.exhibit-ctx-bar {
  display: flex;
  align-items: center;
  padding: 14rpx 32rpx;
  background: #FFF5EE;
  border-bottom: 2rpx solid #E8C4A0;
  flex-shrink: 0;
  gap: 12rpx;
}

.ctx-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.ctx-name {
  flex: 1;
  font-size: 24rpx;
  color: #5A3E2B;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ctx-close {
  font-size: 30rpx;
  color: #8A6E55;
  padding: 4rpx 8rpx;
  flex-shrink: 0;
  line-height: 1;
}

/* ── Message list ────────────────────────────────────────────────────────── */

.msg-list {
  flex: 1;
  overflow: hidden;
}

.msg-list-inner {
  padding: 24rpx 24rpx 16rpx;
}

/* ── RAG pipeline progress bar ──────────────────────────────────────────── */

.rag-bar {
  margin: 4rpx 8rpx 20rpx;
  background: #F5F0E8;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
}

.rag-step {
  display: flex;
  align-items: center;
  gap: 8rpx;
  transition: opacity 0.3s;
}

.rag-step--pending {
  opacity: 0.35;
}

.rag-step--running {
  opacity: 1;
}

.rag-step--completed {
  opacity: 0.55;
}

.rag-icon {
  font-size: 24rpx;
}

.rag-label {
  font-size: 22rpx;
  color: #5A3E2B;
}

.rag-indicator {
  font-size: 20rpx;
}

.rag-running {
  color: #C4845A;
  animation: rag-pulse 1s ease-in-out infinite;
}

.rag-done {
  color: #7A9B6E;
}

@keyframes rag-pulse {
  0%, 100% { opacity: 0.4; }
  50%       { opacity: 1;   }
}

/* ── Thinking dots ───────────────────────────────────────────────────────── */

.thinking-row {
  display: flex;
  justify-content: flex-start;
  padding: 8rpx 16rpx 8rpx;
}

.thinking-dots {
  display: flex;
  gap: 10rpx;
  background: #F5F0E8;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  border-bottom-left-radius: 6rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #C4845A;
  animation: blink 1.2s infinite;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes blink {
  0%, 80%, 100% { opacity: 0.2; }
  40%            { opacity: 1;   }
}

/* ── Progressive loading hint text ──────────────────────────────────────── */

.loading-hint-row {
  display: flex;
  justify-content: flex-start;
  padding: 0 16rpx 20rpx;
}

.loading-hint {
  font-size: 22rpx;
  color: #8A6E55;
  line-height: 1.5;
  animation: hint-fade-in 0.35s ease-out;
}

@keyframes hint-fade-in {
  from { opacity: 0; transform: translateY(6rpx); }
  to   { opacity: 1; transform: translateY(0);    }
}

/* ── Guide Suggestions Bar ──────────────────────────────────────────────── */

.suggestions-bar {
  display: flex;
  align-items: center;
  background: #FFF8F0;
  border-top: 2rpx solid #EDD8BE;
  padding: 0 0 0 16rpx;
  flex-shrink: 0;
  min-height: 88rpx;
}

.suggestions-scroll {
  flex: 1;
  /* width:0 lets flex:1 calculate correctly without overflowing parent */
  width: 0;
}

.suggestions-inner {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 8rpx;
  white-space: nowrap;
}

.suggestion-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #FAF0E0;
  border: 2rpx solid #E0C4A0;
  border-radius: 36rpx;
  white-space: nowrap;
  flex-shrink: 0;
  transition: background 0.15s, opacity 0.15s;
}

.suggestion-chip:active {
  background: #F0E0C8;
  opacity: 0.75;
}

.sg-icon {
  font-size: 26rpx;
  line-height: 1;
}

.sg-title {
  font-size: 24rpx;
  color: #5A3E2B;
  font-weight: 500;
  line-height: 1.3;
}

.suggestions-dismiss {
  padding: 16rpx 24rpx;
  font-size: 36rpx;
  color: #B08060;
  flex-shrink: 0;
  line-height: 1;
}

/* ── Input bar ───────────────────────────────────────────────────────────── */

.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx 40rpx;
  background: #F5F0E8;
  border-top: 2rpx solid #DDD0C0;
  gap: 12rpx;
  flex-shrink: 0;
}

.exhibit-search-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 72rpx;
  padding: 0 18rpx;
  background: #FAF7F2;
  border: 2rpx solid #D8C7B4;
  border-radius: 36rpx;
  color: #6B4A32;
  box-sizing: border-box;
  flex-shrink: 0;
}

.exhibit-search-btn:active {
  background: #EFE5D8;
  opacity: 0.8;
}

.exhibit-search-icon {
  font-size: 26rpx;
  line-height: 1;
}

.exhibit-search-text {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

.input-field {
  flex: 1;
  min-width: 0;
  background: #FAF7F2;
  border: 2rpx solid #DDD0C0;
  border-radius: 40rpx;
  padding: 18rpx 28rpx;
  font-size: 28rpx;
  color: #2C1810;
  min-height: 72rpx;
  box-sizing: border-box;
}

.send-btn {
  font-size: 28rpx;
  color: #DDD0C0;
  flex-shrink: 0;
  padding: 0 8rpx;
  transition: color 0.2s;
}

.send-btn.active {
  color: #C4845A;
  font-weight: 600;
}

/* ── Stop generation button ──────────────────────────────────────────────── */

.stop-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  background: #FFF5EE;
  border: 2rpx solid #C4845A;
  border-radius: 36rpx;
  flex-shrink: 0;
  /* tap feedback */
  transition: background 0.15s, opacity 0.15s;
}

.stop-btn:active {
  opacity: 0.7;
  background: #FAE8D8;
}

.stop-icon {
  width: 22rpx;
  height: 22rpx;
  background: #C4845A;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.stop-label {
  font-size: 26rpx;
  color: #C4845A;
  font-weight: 500;
  line-height: 1;
}
