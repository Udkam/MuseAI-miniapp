<view class="tour-page">

  <!-- Top bar -->
  <view class="tour-topbar">
    <text class="topbar-hall">{{hallName}}</text>
    <view class="topbar-actions">
      <text class="topbar-btn" bindtap="goRoute">路线</text>
      <text class="topbar-sep">|</text>
      <text class="topbar-btn" bindtap="goReport">报告</text>
      <text class="topbar-sep">|</text>
      <text class="topbar-btn topbar-btn-ping" bindtap="checkHealth">连接</text>
    </view>
  </view>

  <!-- Exhibit Context Bar (only shown when entered via exhibit-detail goDeeper) -->
  <view wx:if="{{currentExhibit}}" class="exhibit-ctx-bar">
    <text class="ctx-icon">🏺</text>
    <text class="ctx-name">正在讨论：{{currentExhibit.name}}</text>
    <text class="ctx-close" bindtap="clearExhibitContext">✕</text>
  </view>

  <!-- Message list -->
  <scroll-view
    class="msg-list"
    scroll-y
    scroll-into-view="{{scrollTarget}}"
    scroll-with-animation
  >
    <view class="msg-list-inner">

      <!-- ── Committed messages ── -->
      <message-bubble
        wx:for="{{messages}}"
        wx:key="id"
        role="{{item.role}}"
        content="{{item.content}}"
        is-error="{{item.isError}}"
      />

      <!-- ── RAG pipeline progress bar ── -->
      <view wx:if="{{ragSteps.length > 0 && (isThinking || isStreaming)}}" class="rag-bar">
        <view
          wx:for="{{ragSteps}}"
          wx:key="step"
          wx:for-item="rs"
          class="rag-step rag-step--{{rs.status}}"
        >
          <text class="rag-icon">{{rs.icon}}</text>
          <text class="rag-label">{{rs.label}}</text>
          <text wx:if="{{rs.status === 'running'}}"   class="rag-indicator rag-running">…</text>
          <text wx:if="{{rs.status === 'completed'}}" class="rag-indicator rag-done">✓</text>
        </view>
      </view>

      <!-- ── Thinking dots (waiting for first chunk) ── -->
      <view wx:if="{{isThinking && !isStreaming}}" class="thinking-row">
        <view class="thinking-dots">
          <view class="dot"></view>
          <view class="dot"></view>
          <view class="dot"></view>
        </view>
      </view>

      <!-- ── Progressive loading hint text ── -->
      <view wx:if="{{isThinking && !isStreaming && loadingHint}}" class="loading-hint-row">
        <text class="loading-hint">{{loadingHint}}</text>
      </view>

      <!-- ── Live streaming assistant bubble ── -->
      <view wx:if="{{isStreaming}}" class="stream-bubble">
        <view class="stream-bubble-inner">
          <text class="stream-text" selectable>{{streamingContent}}</text>
          <view class="typing-cursor"></view>
        </view>
      </view>

      <!-- Scroll anchors (toggle between a/b so scroll-into-view always fires) -->
      <view id="msg-bottom-a" style="height:1rpx;"></view>
      <view id="msg-bottom-b" style="height:1rpx;"></view>

    </view>
  </scroll-view>

  <!-- Guide Suggestions Bar -->
  <view wx:if="{{showSuggestions && guideSuggestions.length > 0}}" class="suggestions-bar">
    <scroll-view scroll-x class="suggestions-scroll">
      <view class="suggestions-inner">
        <view
          wx:for="{{guideSuggestions}}"
          wx:key="id"
          class="suggestion-chip"
          data-index="{{index}}"
          bindtap="onSuggestionTap"
        >
          <text class="sg-icon">{{item.icon}}</text>
          <text class="sg-title">{{item.title}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="suggestions-dismiss" bindtap="dismissSuggestions">×</view>
  </view>

  <!-- Input bar -->
  <view class="input-bar">
    <text class="input-icon" bindtap="goScan">📷</text>
    <input
      class="input-field"
      value="{{inputText}}"
      bindinput="onInputChange"
      placeholder="问问 MuseAI…"
      confirm-type="send"
      bindconfirm="sendMessage"
      adjust-position
    />

    <!-- Stop button: visible while thinking or streaming -->
    <view wx:if="{{isThinking || isStreaming}}" class="stop-btn" bindtap="stopStream">
      <view class="stop-icon"></view>
      <text class="stop-label">停止</text>
    </view>

    <!-- Send button: visible when idle -->
    <text
      wx:else
      class="send-btn {{inputText ? 'active' : ''}}"
      bindtap="sendMessage"
    >发送</text>
  </view>

</view>
