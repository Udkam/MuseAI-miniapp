<view class="bubble-wrap {{role}}">
  <view class="bubble {{role}}{{isError ? ' error' : ''}}">

    <!-- User message: always plain text -->
    <text wx:if="{{role === 'user'}}" class="bubble-text" selectable="{{true}}" user-select="{{true}}">{{content}}</text>

    <!-- Assistant message with Markdown blocks -->
    <view wx:elif="{{role === 'assistant' && blocks.length > 0}}" class="md-body">
      <block wx:for="{{blocks}}" wx:key="id" wx:for-item="blk">

        <!-- Headings h1 / h2 / h3 -->
        <text wx:if="{{blk.type === 'heading'}}" class="md-h md-h{{blk.level}}" selectable="{{true}}" user-select="{{true}}">{{blk.text}}</text>

        <!-- Paragraph: inline segments (bold / code / plain) -->
        <text wx:elif="{{blk.type === 'paragraph'}}" class="md-p" selectable="{{true}}" user-select="{{true}}">
          <text
            wx:for="{{blk.segments}}"
            wx:key="text"
            wx:for-index="si"
            wx:for-item="seg"
            class="md-seg{{seg.bold ? ' md-bold' : ''}}{{seg.code ? ' md-code' : ''}}"
          >{{seg.text}}</text>
        </text>

        <!-- List: unordered bullet • or ordered 1. 2. -->
        <view wx:elif="{{blk.type === 'list'}}" class="md-list">
          <view
            wx:for="{{blk.items}}"
            wx:key="index"
            wx:for-index="li"
            wx:for-item="listItem"
            class="md-li"
          >
            <text class="md-bullet">{{blk.ordered ? ((blk.start || 1) + li)+'.' : '•'}}</text>
            <text class="md-li-body" selectable="{{true}}" user-select="{{true}}">
              <text
                wx:for="{{listItem}}"
                wx:key="text"
                wx:for-index="si2"
                wx:for-item="seg2"
                class="md-seg{{seg2.bold ? ' md-bold' : ''}}{{seg2.code ? ' md-code' : ''}}"
              >{{seg2.text}}</text>
            </text>
          </view>
        </view>

      </block>
    </view>

    <!-- Fallback: no blocks (empty content or user msg edge case) -->
    <text wx:else class="bubble-text" selectable="{{true}}" user-select="{{true}}">{{content}}</text>

    <view wx:if="{{role === 'assistant' && isStreaming}}" class="typing-cursor"></view>
    <view wx:if="{{role === 'assistant' && content && !isStreaming}}" class="bubble-actions">
      <view wx:if="{{showTts && !isError}}" class="bubble-tts {{ttsStatus === 'playing' ? 'playing' : ''}}" bindtap="requestTts">
        <text class="bubble-tts-text">{{ttsStatus === 'loading' ? '生成语音…' : (ttsStatus === 'playing' ? '停止' : '播放')}}</text>
      </view>
      <view class="bubble-copy" bindtap="copyContent">
        <text class="bubble-copy-text">复制</text>
      </view>
    </view>

  </view>
</view>
