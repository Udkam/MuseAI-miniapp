/* ── Bubble layout ─────────────────────────────────────────────────────────── */

.bubble-wrap {
  display: flex;
  margin-bottom: 24rpx;
}

.bubble-wrap.user {
  justify-content: flex-end;
}

.bubble-wrap.assistant {
  justify-content: flex-start;
}

.bubble {
  max-width: 78%;
  padding: 24rpx 30rpx;
  border-radius: 2rpx;
  position: relative;
  user-select: text;
}

.bubble.user {
  background: #3F2A1D;
  border-right: 6rpx solid #A85732;
}

.bubble.assistant {
  background: #F3EADD;
  border-left: 4rpx solid #8B5E3C;
}

.bubble.assistant.error {
  background: #FDF2F0;
  border-left: 6rpx solid #C0392B;
}

/* ── User bubble: plain text ──────────────────────────────────────────────── */

.bubble-text {
  font-size: 28rpx;
  line-height: 1.75;
  white-space: pre-wrap;
  word-break: break-all;
}

.bubble.user .bubble-text {
  color: #F3EADD;
}

.bubble.assistant .bubble-text {
  color: #241712;
}

/* ── Markdown body (assistant only) ──────────────────────────────────────── */

.md-body {
  width: 100%;
}

/* Heading base */
.md-h {
  display: block;
  font-weight: 700;
  color: #241712;
  margin-top: 4rpx;
  margin-bottom: 10rpx;
  line-height: 1.5;
}

.md-h1 { font-size: 34rpx; }
.md-h2 { font-size: 31rpx; }
.md-h3 {
  font-size: 29rpx;
  color: #5A3E2B;
  font-weight: 600;
}

/* Paragraph */
.md-p {
  margin-bottom: 14rpx;
  line-height: 1.8;
  font-size: 28rpx;
  color: #241712;
  /* allow inline <text> elements to wrap naturally */
  display: block;
}

/* Last paragraph: no bottom margin */
.md-p:last-child {
  margin-bottom: 0;
}

/* Inline text segment — must be inline to allow mixed bold/plain on one line */
.md-seg {
  display: inline;
  font-size: 28rpx;
  color: #241712;
  line-height: 1.8;
}

.md-bold {
  font-weight: 900;
  color: #1F120B;
  text-shadow: 0 0 0 #1F120B;
}

.md-code {
  font-family: monospace;
  font-size: 25rpx;
  background: #E8DDD0;
  color: #5A3E2B;
  padding: 0 8rpx;
  border-radius: 6rpx;
  letter-spacing: 0;
}

/* ── List ────────────────────────────────────────────────────────────────── */

.md-list {
  margin-bottom: 14rpx;
}

.md-list:last-child {
  margin-bottom: 0;
}

.md-li {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.md-li:last-child {
  margin-bottom: 0;
}

.md-bullet {
  flex-shrink: 0;
  width: 40rpx;
  font-size: 28rpx;
  color: #A85732;
  font-weight: 600;
  line-height: 1.8;
  text-align: left;
}

.md-li-body {
  flex: 1;
  line-height: 1.8;
}

/* ── Streaming cursor ───────────────────────────────────────────────────── */

.typing-cursor {
  display: inline-block;
  width: 4rpx;
  height: 28rpx;
  background: #A85732;
  border-radius: 2rpx;
  margin-top: 4rpx;
  animation: cursor-blink 0.8s step-end infinite;
}

.bubble-actions {
  margin-top: 14rpx;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 12rpx;
}

.bubble-tts,
.bubble-copy {
  min-width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: -12rpx 0 -20rpx;
}

.bubble-copy {
  display: flex;
  justify-content: flex-end;
}

.bubble-copy-text,
.bubble-tts-text {
  font-size: 22rpx;
  color: #9A7458;
  background: #FFF9F1;
  border: 2rpx solid #EAD9C9;
  border-radius: 2rpx;
  padding: 4rpx 18rpx;
}

.bubble-tts.playing .bubble-tts-text {
  color: #A85732;
  border-color: #E8C4A0;
  background: #FFF5EE;
}

@keyframes cursor-blink {
  0%, 100% { opacity: 1; }
  50%      { opacity: 0; }
}
