/* ── Bubble layout ─────────────────────────────────────────────────────────── */

.bubble-wrap {
  display: flex;
  margin-bottom: 24rpx;
}

.bubble-wrap.user {
  justify-content: flex-end;
}

.bubble-wrap.assistant {
  justify-content: flex-start;
}

.bubble {
  max-width: 78%;
  padding: 24rpx 30rpx;
  border-radius: 24rpx;
}

.bubble.user {
  background: #3D2B1A;
  border-bottom-right-radius: 6rpx;
}

.bubble.assistant {
  background: #F5F0E8;
  border-bottom-left-radius: 6rpx;
}

.bubble.assistant.error {
  background: #FDF2F0;
  border-left: 6rpx solid #C0392B;
}

/* ── User bubble: plain text ──────────────────────────────────────────────── */

.bubble-text {
  font-size: 28rpx;
  line-height: 1.75;
  white-space: pre-wrap;
  word-break: break-all;
}

.bubble.user .bubble-text {
  color: #F5F0E8;
}

.bubble.assistant .bubble-text {
  color: #2C1810;
}

/* ── Markdown body (assistant only) ──────────────────────────────────────── */

.md-body {
  width: 100%;
}

/* Heading base */
.md-h {
  display: block;
  font-weight: 700;
  color: #2C1810;
  margin-top: 4rpx;
  margin-bottom: 10rpx;
  line-height: 1.5;
}

.md-h1 { font-size: 34rpx; }
.md-h2 { font-size: 31rpx; }
.md-h3 {
  font-size: 29rpx;
  color: #5A3E2B;
  font-weight: 600;
}

/* Paragraph */
.md-p {
  margin-bottom: 14rpx;
  line-height: 1.8;
  font-size: 28rpx;
  color: #2C1810;
  /* allow inline <text> elements to wrap naturally */
  display: block;
}

/* Last paragraph: no bottom margin */
.md-p:last-child {
  margin-bottom: 0;
}

/* Inline text segment — must be inline to allow mixed bold/plain on one line */
.md-seg {
  display: inline;
  font-size: 28rpx;
  color: #2C1810;
  line-height: 1.8;
}

.md-bold {
  font-weight: 700;
  color: #3D2B1A;
}

.md-code {
  font-family: monospace;
  font-size: 25rpx;
  background: #E8DDD0;
  color: #5A3E2B;
  padding: 0 8rpx;
  border-radius: 6rpx;
  letter-spacing: 0;
}

/* ── List ────────────────────────────────────────────────────────────────── */

.md-list {
  margin-bottom: 14rpx;
}

.md-list:last-child {
  margin-bottom: 0;
}

.md-li {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.md-li:last-child {
  margin-bottom: 0;
}

.md-bullet {
  flex-shrink: 0;
  width: 40rpx;
  font-size: 28rpx;
  color: #C4845A;
  font-weight: 600;
  line-height: 1.8;
  text-align: left;
}

.md-li-body {
  flex: 1;
  line-height: 1.8;
}
