.persona-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 24rpx;
  background: #F3EADD;
  border: 3rpx solid transparent;
  border-radius: 20rpx;
  text-align: center;
  transition: border-color 0.2s;
}

.persona-card.selected {
  border-color: #A85732;
  background: #FFF7EF;
}

.pc-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.pc-label {
  font-size: 32rpx;
  font-weight: 700;
  color: #3F2A1D;
  margin-bottom: 12rpx;
}

.pc-desc {
  font-size: 24rpx;
  color: #7C6654;
  line-height: 1.5;
}
