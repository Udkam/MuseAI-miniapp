.exhibit-card {
  display: flex;
  align-items: flex-start;
  background: #F3EADD;
  border-radius: 20rpx;
  padding: 24rpx;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.ec-img-placeholder {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #FFF9F1 0%, #E7D8C5 100%);
  border: 2rpx solid #E6D8C6;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ec-icon {
  font-size: 48rpx;
  line-height: 1;
}

.ec-body {
  flex: 1;
  overflow: hidden;
}

.ec-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #3F2A1D;
  display: block;
  margin-bottom: 10rpx;
}

.ec-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.ec-tag {
  font-size: 22rpx;
  color: #7C6654;
  background: #E7D8C5;
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
}

.ec-tag-hall {
  background: #A8573218;
  color: #A85732;
}

.ec-desc {
  font-size: 24rpx;
  color: #7C6654;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
